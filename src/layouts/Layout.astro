---
import '@fontsource/fira-sans-extra-condensed/600.css';
import '@fontsource/fira-sans-extra-condensed/700.css';
import '@fontsource/fira-sans-extra-condensed/800.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/global.css';
import fuenteRotulo from '@fontsource/fira-sans-extra-condensed/files/fira-sans-extra-condensed-latin-800-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import CookieBanner from '../components/CookieBanner.astro';
import LineasPista from '../components/LineasPista.astro';
import { type Locale, LOCALES, localizedPath, basePath, isRtl } from '../lib/i18n';
import { getDict } from '../lib/dictionary';
import { IDIOMAS } from '../data/idiomas.js';
import { REDES } from '../data/redes.js';
import { VERSIONES } from '../data/legal.js';
import sunIcon from 'lucide-static/icons/sun.svg?raw';
import moonIcon from 'lucide-static/icons/moon.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	lang?: Locale;
	panelPrivado?: boolean;
}

const {
	title = 'Mario Álvarez — Científico de datos especializado en deporte',
	description = 'Mario Álvarez, científico de datos en Valencia especializado en analítica deportiva. Campeón de España de madison y director deportivo RFEC.',
	noindex = false,
	lang = 'es',
	panelPrivado = false,
} = Astro.props;

const t = getDict(lang, 'common') as any;
const dir = isRtl(lang) ? 'rtl' : 'ltr';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-card.png?v=1', Astro.site);
const socialImageAlt = 'Mario Álvarez — científico de datos especializado en analítica deportiva';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const rutaBase = basePath(currentPath);
const hreflangs = LOCALES.map((locale) => ({ locale, href: new URL(localizedPath(rutaBase, locale), Astro.site) }));
const pathES = localizedPath(rutaBase, 'es');
const pathEN = localizedPath(rutaBase, 'en');
const inicioHref = localizedPath('/', lang);
const contactoHref = localizedPath('/contacto', lang);

const navLinks = [
	{ href: localizedPath('/sobre-mi', lang), label: t.nav.sobreMi },
	{ href: localizedPath('/proyectos', lang), label: t.nav.proyectos },
	{ href: localizedPath('/experiencia', lang), label: t.nav.experiencia },
	{ href: contactoHref, label: t.nav.contacto },
];

const isActive = (href: string) => currentPath === href;


const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Mario Álvarez',
	jobTitle: t.person.jobTitle,
	description: t.person.description,
	url: 'https://marioalvarez.me',
	image: 'https://marioalvarez.me/mario.webp',
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Universitat Politècnica de València',
	},
	knowsAbout: ['Ciencia de datos', 'Analítica deportiva', 'Ciclismo', 'Machine Learning', 'Python', 'SQL', 'R', 'Power BI'],
	sameAs: REDES.map((red) => red.href),
};
---

<!doctype html>
<html lang={lang} dir={dir} data-versiones={JSON.stringify(VERSIONES)}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				var raiz = document.documentElement;
				raiz.classList.add('js');
				var guardado = null;
				try {
					guardado = localStorage.getItem('tema');
				} catch (e) {}
				var tema = guardado || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				raiz.setAttribute('data-theme', tema);
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#111214" id="meta-theme-color" />
		<script is:inline>
			(function () {
				var claro = document.documentElement.getAttribute('data-theme') === 'light';
				var meta = document.getElementById('meta-theme-color');
				if (meta) meta.setAttribute('content', claro ? '#f3f3f0' : '#111214');
			})();
		</script>
		<link rel="preload" href={fuenteRotulo} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png?v=3" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonicalURL} />
		{hreflangs.map(({ locale, href }) => <link rel="alternate" hreflang={locale} href={href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(pathES, Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Mario Álvarez" />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
		<meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
	</head>
	<body>
		{!panelPrivado && <a class="saltar" href="#contenido">{t.saltar ?? 'Saltar al contenido'}</a>}

		{
			!panelPrivado && (
				<header id="site-header">
					<div class="container nav-inner">
						<a href={inicioHref} class="brand" aria-label={`Mario Álvarez, ${t.nav.inicio ?? 'Inicio'}`}>
							<img src="/mark-blanco.png" alt="" width="61" height="26" class="brand-mark" />
							<span class="brand-name">Mario Álvarez</span>
						</a>

						<nav id="site-nav" aria-label={t.nav.ariaMain}>
							<ul>
								{navLinks.map((link, i) => (
									<li style={`--i:${i}`}>
										<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</nav>

						<div class="nav-actions">
							<div class="lang-switch" aria-label={t.langSwitch.label}>
								<div class="lang-selector">
									<button
										type="button"
										id="lang-globe-btn"
										class="lang-globe-btn"
										aria-haspopup="listbox"
										aria-expanded="false"
										aria-controls="lang-menu"
										aria-label={t.langSwitch.traducir}
									>
										<span class="lang-globe-icon" set:html={globeIcon} />
									</button>

									<div id="lang-menu" class="lang-menu" role="listbox" aria-label={t.langSwitch.traducir} hidden>
										<div class="lang-menu-buscador-wrap">
											<input
												type="text"
												class="lang-menu-buscador"
												placeholder={t.langSwitch.buscar}
												aria-label={t.langSwitch.buscar}
												autocomplete="off"
											/>
										</div>
										<ul class="lang-menu-lista">
											{IDIOMAS.map((idioma) => (
												<li>
													<a
														role="option"
														class:list={['lang-menu-opcion', { 'is-selected': lang === idioma.codigo }]}
														href={localizedPath(rutaBase, idioma.codigo as Locale)}
														aria-selected={lang === idioma.codigo ? 'true' : 'false'}
														data-busqueda={`${idioma.nombre} ${idioma.nombreEs} ${idioma.codigo}`.toLowerCase()}
													>
														<span class="lang-menu-nombre">{idioma.nombre}</span>
														<span class="lang-menu-codigo">{idioma.codigo.toUpperCase()}</span>
													</a>
												</li>
											))}
										</ul>
									</div>
								</div>

								<span class="lang-switch-divisor" aria-hidden="true" />

								<a href={pathES} hreflang="es" aria-current={lang === 'es' ? 'true' : undefined}>
									ES
								</a>
								<span class="lang-switch-divisor" aria-hidden="true" />
								<a href={pathEN} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>
									EN
								</a>
							</div>
							<button type="button" id="btn-tema" class="btn-tema" aria-label={t.tema ?? 'Cambiar entre modo claro y oscuro'}>
								<span class="icono-tema icono-luna" set:html={moonIcon} />
								<span class="icono-tema icono-sol" set:html={sunIcon} hidden />
							</button>
							<a href={contactoHref} class="btn btn-primary nav-cta">
								{t.nav.contacto}
							</a>
							<button id="nav-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="site-nav">
								<span />
								<span />
								<span />
							</button>
						</div>
					</div>
				</header>
			)
		}

		<main id="contenido" class={panelPrivado ? 'main-sin-cabecera' : undefined} tabindex="-1">
			<slot />
		</main>

		{
			!panelPrivado && (
				<div id="pizarra" class="pizarra" aria-hidden="true" data-vueltas={t.pizarra.vueltas} data-campana={t.pizarra.campana} hidden>
					<span class="pizarra-num">
						<span class="pizarra-digito" />
					</span>
					<span class="pizarra-label">{t.pizarra.vueltas}</span>
				</div>
			)
		}

		{
			!panelPrivado && (
				<footer id="pie" class="pie">
					<LineasPista alEntrar meta fin={86} class="pie-lineas" />

					<div class="container">
						<div class="pie-cols">
							<div class="pie-presentacion">
								<a href={inicioHref} class="pie-logo" aria-label={`Mario Álvarez, ${t.nav.inicio ?? 'Inicio'}`}>
									<img src="/mark-blanco.png" alt="" width="728" height="311" class="pie-logo-img" loading="lazy" decoding="async" />
								</a>
								<a href={contactoHref} class="link-arrow pie-escribeme">
									{t.footer.escribeme}
								</a>
							</div>

							<nav class="pie-col" aria-label={t.footer.navLabel ?? t.nav.ariaMain}>
								<ul>
									<li>
										<a href={inicioHref}>{t.nav.inicio ?? 'Inicio'}</a>
									</li>
									{navLinks.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							</nav>

							<ul class="pie-col" aria-label={t.footer.legalLabel ?? 'Legal'}>
								<li>
									<a href={localizedPath('/terminos-y-condiciones', lang)}>{t.legal.terminos ?? 'Términos y condiciones'}</a>
								</li>
								<li>
									<a href={localizedPath('/politica-de-privacidad', lang)}>{t.legal.privacidad}</a>
								</li>
								<li>
									<a href={localizedPath('/politica-de-cookies', lang)}>{t.legal.cookies}</a>
								</li>
								<li>
									<a href={localizedPath('/politica-de-reembolso', lang)}>{t.legal.reembolso ?? 'Política de reembolso'}</a>
								</li>
								<li>
									<button type="button" id="cookie-config-btn" class="pie-boton">
										{t.cookies.configurar}
									</button>
								</li>
							</ul>
						</div>

						<!-- El cierre: las redes, grandes, con su logo -->
						<ul class="pie-redes" aria-label={t.footer.ariaSocial}>
							{REDES.map((red, i) => (
								<li data-entra style={`--i:${i}; --marca:${red.color}`}>
									<a
										href={red.href}
										target="_blank"
										rel="noopener noreferrer me"
										class="pie-red"
										aria-label={`${red.label}: ${red.usuario}`}
										data-tracking-clic={red.label}
									>
										<svg class="pie-red-logo" viewBox={red.viewBox} fill="currentColor" fill-rule={red.relleno ?? 'nonzero'} aria-hidden="true" focusable="false">
											<path d={red.path} />
										</svg>
										<span class="pie-red-texto">
											<span class="pie-red-nombre">{red.label}</span>
											<span class="pie-red-usuario">{red.usuario}</span>
										</span>
									</a>
								</li>
							))}
						</ul>

						<div class="pie-base">
							<p>
								© {new Date().getFullYear()} {t.footer.copySufijo}
							</p>
						</div>
					</div>
				</footer>
			)
		}

		{!panelPrivado && <CookieBanner lang={lang} />}

		<script>
			const raiz = document.documentElement;
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('site-nav');

			const cerrarMenu = () => {
				nav?.classList.remove('is-open');
				toggle?.setAttribute('aria-expanded', 'false');
				raiz.classList.remove('menu-abierto');
			};

			toggle?.addEventListener('click', () => {
				const isOpen = Boolean(nav?.classList.toggle('is-open'));
				toggle.setAttribute('aria-expanded', String(isOpen));
				raiz.classList.toggle('menu-abierto', isOpen);
			});

			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', cerrarMenu));
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
					cerrarMenu();
					toggle?.focus();
				}
			});
			window.matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
				if (e.matches) cerrarMenu();
			});

			// Tema claro/oscuro: también cambia el color de la barra del navegador en el móvil.
			const btnTema = document.getElementById('btn-tema');
			const iconoLuna = btnTema?.querySelector('.icono-luna');
			const iconoSol = btnTema?.querySelector('.icono-sol');
			const metaTema = document.getElementById('meta-theme-color');

			const pintarIconoTema = (tema: string | null) => {
				const esClaro = tema === 'light';
				iconoLuna?.toggleAttribute('hidden', esClaro);
				iconoSol?.toggleAttribute('hidden', !esClaro);
				metaTema?.setAttribute('content', esClaro ? '#f3f3f0' : '#111214');
			};

			pintarIconoTema(raiz.getAttribute('data-theme'));

			btnTema?.addEventListener('click', () => {
				const nuevoTema = raiz.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
				raiz.setAttribute('data-theme', nuevoTema);
				try {
					localStorage.setItem('tema', nuevoTema);
				} catch {}
				pintarIconoTema(nuevoTema);
			});

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Las páginas antiguas aún marcan bloques con .reveal; ya no se animan, solo se muestran.
			document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));

			/*
			 * Pizarra de vueltas: en una madison, la pizarra de meta cuenta las vueltas que faltan.
			 * Cada sección con data-vuelta="N" pone el marcador en N al cruzar el centro de la
			 * pantalla; en la 1 suena la campana (última vuelta).
			 */
			const pizarra = document.getElementById('pizarra');
			const tramos = document.querySelectorAll<HTMLElement>('[data-vuelta]');

			if (pizarra && tramos.length > 0) {
				const digito = pizarra.querySelector<HTMLElement>('.pizarra-digito')!;
				const etiqueta = pizarra.querySelector<HTMLElement>('.pizarra-label')!;
				let actual = '';

				const pintar = (valor: string) => {
					if (valor === actual) return;
					const anterior = actual;
					actual = valor;
					const esCampana = valor === '1';
					pizarra.classList.toggle('is-campana', esCampana);
					etiqueta.textContent = esCampana ? pizarra.dataset.campana! : pizarra.dataset.vueltas!;

					if (!anterior || prefersReducedMotion) {
						digito.textContent = valor;
						return;
					}

					// Bajamos por la página = quedan menos vueltas: el número nuevo entra desde abajo.
					const bajando = Number(valor) < Number(anterior);
					const salida = bajando ? '-100%' : '100%';
					const entrada = bajando ? '100%' : '-100%';

					digito
						.animate([{ transform: 'translateY(0)' }, { transform: `translateY(${salida})` }], {
							duration: 140,
							easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
						})
						.finished.then(() => {
							digito.textContent = valor;
							digito.animate([{ transform: `translateY(${entrada})` }, { transform: 'translateY(0)' }], {
								duration: 260,
								easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
							});
						})
						.catch(() => {
							digito.textContent = valor;
						});

					if (esCampana) {
						pizarra.animate(
							[
								{ transform: 'rotate(0deg)' },
								{ transform: 'rotate(-7deg)' },
								{ transform: 'rotate(6deg)' },
								{ transform: 'rotate(-4deg)' },
								{ transform: 'rotate(2deg)' },
								{ transform: 'rotate(0deg)' },
							],
							{ duration: 620, easing: 'ease-out', delay: 120 },
						);
					}
				};

				const observador = new IntersectionObserver(
					(lista) => {
						lista.forEach((entrada) => {
							if (entrada.isIntersecting) pintar((entrada.target as HTMLElement).dataset.vuelta!);
						});
					},
					{ rootMargin: '-50% 0px -50% 0px' },
				);

				tramos.forEach((tramo) => observador.observe(tramo));

				// La última vuelta puede no llegar al centro de la pantalla en móviles con footer alto.
				const ultimo = tramos[tramos.length - 1];
				new IntersectionObserver(
					([entrada]) => {
						if (entrada.isIntersecting) pintar(ultimo.dataset.vuelta!);
					},
					{ threshold: 0.6 },
				).observe(ultimo);
				pintar(tramos[0].dataset.vuelta!);
				pizarra.hidden = false;

				// En el pie ya se ha cruzado la meta: la pizarra se retira para no tapar nada.
				const pie = document.getElementById('pie');
				if (pie) {
					new IntersectionObserver(([entrada]) => pizarra.classList.toggle('is-fuera', entrada.isIntersecting), {
						rootMargin: '0px 0px -10% 0px',
					}).observe(pie);
				}
			}
		</script>

		<script>
			import '../scripts/cinematica.ts';
		</script>

		<script>
			import '../scripts/tracking.js';
		</script>

		<script>
			import '../scripts/lang-menu.js';
		</script>
	</body>
</html>

<style>
	/* ---------- Saltar al contenido ---------- */
	.saltar {
		position: fixed;
		inset-block-start: 0.75rem;
		inset-inline-start: 0.75rem;
		z-index: 300;
		padding: 0.6rem 1rem;
		background: var(--color-text);
		color: var(--color-bg);
		font-family: var(--font-display);
		font-weight: 600;
		text-decoration: none;
		border-radius: 4px;
		transform: translateY(-160%);
		transition: transform 0.2s var(--ease-out);
	}

	.saltar:focus-visible {
		transform: none;
	}

	main:focus {
		outline: none;
	}

	/* ---------- Cabecera ---------- */
	#site-header {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 100;
		background: var(--color-bg);
		border-block-end: 1px solid transparent;
		view-transition-name: cabecera;
		transition:
			background-color 0.35s ease,
			border-color 0.35s ease;
	}

	/* El filo inferior aparece cuando el contenido empieza a pasar por debajo (sin JS) */
	@supports (animation-timeline: scroll()) {
		#site-header {
			animation: cabecera-filo linear both;
			animation-timeline: scroll(root);
			animation-range: 0 96px;
		}
	}

	@supports not (animation-timeline: scroll()) {
		#site-header {
			border-block-end-color: var(--color-border);
		}
	}

	@keyframes cabecera-filo {
		to {
			border-block-end-color: var(--color-border);
		}
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: var(--header-h);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-height: 44px;
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: 0.005em;
		color: var(--color-text);
	}

	.brand-mark {
		width: auto;
		height: 26px;
		flex-shrink: 0;
	}

	.brand-name {
		white-space: nowrap;
	}

	[data-theme='light'] .brand-mark,
	[data-theme='light'] .pie-logo-img {
		filter: invert(1);
	}

	#site-nav ul {
		display: flex;
		align-items: center;
		gap: 1.9rem;
		list-style: none;
	}

	#site-nav a {
		position: relative;
		display: inline-block;
		padding-block: 0.4rem;
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		color: var(--color-text-dim);
		transition: color var(--transition-fast);
	}

	/* La línea de la sección activa es la sprinter; al pasar por encima se insinúa */
	#site-nav a::after {
		content: '';
		position: absolute;
