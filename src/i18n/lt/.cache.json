		"deporte/0/paragraphs/0": {
			"hash": "431d7654ad9c17cfef188c6dd216d77877c67074b5a70fccc26b28faecb96342",
			"value": "Ispanijos madisono čempionas (18 metų); Pasaulio ir Europos treko čempionatai su Ispanijos rinktine (6 vieta abiejuose); elito sportininkas; aktyvus federuotas treko dviratininkas."
		},
		"deporte/1/title": {
			"hash": "84790bf295460a6481da8ad76c8e18d330f20f20baefb8c4d37a1818f065b8a5",
			"value": "Sportinė direkcija"
		},
		"deporte/1/paragraphs/0": {
			"hash": "5dc31dcec5b8544c3fc67da4aedaf52f4da758ba225c9b41297dbeb77730d51b",
			"value": "I ir II lygio sporto direktorius (RFEC); jaunųjų dviratininkų (14–18 m.) mokymas ir stebėsena kartu su tėčiu; Valensijos bendruomenės rinktinės asistentas varžybose (2026)."
		},
		"deporte/2/title": {
			"hash": "0cfe14a47563f418eb121ade7cad7186d2ee23873832ee8f81b43b56f8c18212",
