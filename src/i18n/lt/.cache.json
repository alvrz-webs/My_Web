			"value": "12 mėnesių"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitante_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "Anoniminis identifikatorius jūsų apsilankymams susieti ir sužinoti, kuris turinys yra naudingas"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "Savas, analitinis (reikalaujantis jūsų sutikimo)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 mėnesių"
		},
		"bloques/3/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "Joks iš šių slapukų nėra trečiųjų šalių, nenaudojamas reklamos tikslais ir nėra bendrinamas su jokiu asmeniu už šios svetainės ribų."
		},
		"bloques/4/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "Galite bet kada pakeisti savo sprendimą arba atšaukti sutikimą naudodamiesi nuoroda \"Konfigūruoti slapukus\" puslapio apačioje ir nedelsdami ištrinti visus savo duomenis paspausdami mygtuką \"Ištrinti mano duomenis\" tame pačiame skydelyje."
		},
		"bloques/5/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "Daugiau informacijos apie tai, kaip tvarkomi jūsų duomenys, rasite Privatumo politikoje."
		}
	},
