		},
		"deporte/2/meta": {
			"hash": "907fae24556078db9b490356a39c8eba0b3c8f124cc2f6172d189ab43f6f3d1a",
			"value": "2025 m. vasara"
		},
		"deporte/2/paragraphs/0": {
			"hash": "c46a0525722fd6b77650f20d6fcb485187aa219ea1b9064462a9b8b533f75a83",
			"value": "Diplomuotas chiromasažuotojas; profesionalių dviratininkų masažuotojas; personalo narys Valensijos bendruomenės rinktinėje, Filipinų kontinentinėje komandoje ir dirbantis su individualiais dviratininkais Benidorme."
		}
	},
