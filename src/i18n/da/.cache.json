		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "Sprog for det besøgte websted."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "Enhedstype (mobil eller computer)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "Omtrentligt land, opnået via Cloudfarers infrastruktur, uden lagring af din IP-adresse."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "Henvisningsside (for eksempel LinkedIn eller en søgemaskine)."
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "Din IP-adresse indsamles ikke, der anvendes ikke browser-fingerprinting-teknikker, og der bruges ikke tredjepartsværktøjer som Google Analytics eller lignende."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. Retsgrundlag"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "Behandlingen er baseret på dit udtrykkelige samtykke (artikel 6, stk. 1, litra a, i GDPR og artikel 22, stk. 2, i LSSI-CE), som du til enhver tid kan trække tilbage via webstedets egen cookie-manager."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. Opbevaringsperiode"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "Data opbevares i højst 12 måneder fra dit sidst besøg, hvorefter de slettes automatisk."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. Modtagere og internationale overførsler"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "Data overdrages eller sælges ikke til tredjeparter. De gemmes i Cloudflare D1, en databasetjeneste leveret af Cloudflare, Inc., der fungerer som databehandler. Cloudflare kan behandle data uden for Det Europæiske Økonomiske Samarbejdsområde; i så fald er en sådan overførsel dækket af EU-Kommissionens godkendte standardkontraktbestemmelser. Flere oplysninger i Cloudfarers privatlivspolitik: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. Dine rettigheder"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "Du kan til enhver tid udøve dine rettigheder til indsigt, berigtigelse, sletning, indsigelse, begrænsning af behandling og dataportabilitet ved at skrive til malvmar5@hotmail.com. Derudover kan du slette dine data med det samme uden at skulle skrive til nogen via knappen \"Slet mine data\", der er tilgængelig i webstedets cookie-indstillinger. Du har også ret til at indgive en klage til den spanske databeskyttelsesmyndighed (www.aepd.es), hvis du mener, at dine rettigheder ikke er blevet behandlet korrekt."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. Ændringer til denne politik"
		},
		"secciones/7/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "Denne politik kan opdateres for at tilpasse sig lovændringer eller ændringer på selve webstedet."
		}
	}
}
