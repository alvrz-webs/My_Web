			"value": "Analyse anvendt til forbedring af sportspræstationer."
		},
		"experienciaResumen/eyebrow": {
			"hash": "2dba6bf7c79f75d22c710e160206dec6460bf0b4509e0afe4778cd89f98e4f68",
			"value": "Erfaring"
		},
		"experienciaResumen/title": {
			"hash": "077eeafeaba85ca233eb8c419d41076238aca8fc18a3d2d035b791607bcccc1a",
			"value": "To verdener, samme sprog: præstationen"
		},
		"experienciaResumen/text": {
			"hash": "fab92a26eae655346db1662eb8971457d54d58c22526368ec25b46ab46f46fee",
			"value": "Jeg har konkurreret på højeste niveau og anvender i dag den samme tilgang på data: Jeg forstår, hvad et tal betyder for en sportsmand, fordi jeg har været den sportsmand."
		},
		"ctaFinal/title": {
			"hash": "4f8488bbf0bfd5f01ce9eceb492dfd38151a6c58c043589aa86a0dbeeea289e0",
			"value": "Skal vi snakke data?"
		},
		"ctaFinal/text": {
			"hash": "d03b92b93f54bdd2b6acaad1dfec53aac018610e7bcfc914c87162edf401a51f",
			"value": "Fortæl mig om dit projekt, og lad os sammen finde ud af, hvor de beslutninger, der forbedrer præstationerne, ligger."
		}
	},
	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "Om mig — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "Fra spansk mester i madison til datavidenskabsstudent: Mario Álvarez' rejse mellem elitecykling og sportsanalyse."
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "Om mig"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "Fra velodromen til data"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "Jeg begyndte med at konkurrere. Som 18-årig blev jeg spansk mester i madison på bane, og det spanske cykellandshold udtog mig til VM og EM, hvor jeg blev nummer seks i begge, hvilket gav mig status som elitesportsperson."
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "Derfra tog jeg springet til datavidenskab: I dag læser jeg på 3. år af bacheloruddannelsen på Universitat Politècnica de València med fokus på digitalisering og teknologi anvendt på sport."
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "Min merværdi er netop den bro: Jeg har oplevet elitepræstationer indefra — som rytter, som ungdomssportsdirektør og som sportsmassør for professionelle cykelryttere — og jeg ved, hvordan man læser dataene bag. Jeg forstår, hvad et tal betyder for en sportsudøver, fordi jeg har været den sportsudøver. Jeg forener de to verdener for at omdanne data til beslutninger, der forbedrer præstationerne."
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "Derudover fik jeg takket være min status som elitesportsperson et legat til at tage en kandidatuddannelse i digitalisering, innovation og teknologi inden for sport, som jeg allerede har fuldført, og som udvider mit fokus til hele sportsøkosystemet, ud over cykling."
		},
		"facts/0/label": {
			"hash": "7b47361aad19bb483aeab081a7df0a55f7cb0fdb3327efe6dd016e6353a17880",
			"value": "Base"
