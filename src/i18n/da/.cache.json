		"sobreMiResumen/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "Om mig"
		},
		"sobreMiResumen/title": {
			"hash": "6210f2e44a03903aa5b0bea20e2d29f04b9a9ee5abc860781e046649f0067aaa",
			"value": "Data med kontekst fra bane, landevej og konkurrence"
		},
		"sobreMiResumen/text": {
			"hash": "dad327cad1b7a9fd0fad2c312612e980b47320b4be9cb2c245f19d427e83cf14",
			"value": "Jeg er Mario Álvarez, datavidenskabsstuderende på UPV med reel erfaring fra professionel cykling. Jeg kombinerer dataanalyse med eliteidrætspræstationer for at omdanne hver enkelt måling til en beslutning, der forbedrer resultaterne."
		},
