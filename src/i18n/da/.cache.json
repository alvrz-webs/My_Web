			"value": "To verdener, ét og samme sprog: ydeevne"
		},
		"meta/colDatos": {
			"hash": "0225f00994c5c8be452413f81280ca9e776cf552a94df02388948f87ef1bd464",
			"value": "Data & Teknologi"
		},
		"meta/colDeporte": {
			"hash": "663be1ebba5f3d435a2ed6113e5483f7d94a2c384cb631a57a3372474d9c2856",
			"value": "Elitesport"
		},
		"datos/0/title": {
			"hash": "13cef0dcb61fc73058ec321707889f11b0168613745fa04b982101456aea1628",
			"value": "SIME TELECOM — Praktik i datatruenskab"
		},
		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "Data Engineering · Benidorm · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME udvikler administrationssoftware (reservationer, fakturering, rapporter, restaurantbestillinger), som betjener hundreder af kunder fra et centralt system baseret på en database med +580 indbyrdes forbundne tabeller og +100 millioner poster. Væksten havde gjort det nødvendigt at fordele kunder på flere databaser for at lette belastningen og klager over langsommelighed."
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "Mit arbejde: at analysere disse databaser og gennem forespørgsels- og indeksoptimering designe samlingen af alle data i en enkelt, effektiv database uden nævneværdig skalering af hardware (RAM/CPU). Forbedringen er allerede udviklet og er i valideringsfasen på en testserver."
		},
		"datos/1/title": {
			"hash": "713d758668b5870715b25afdbd2943093657f8f79038522da209181e9032bfb2",
			"value": "Projekter med Cofidis-holdet (World Tour)"
		},
		"datos/1/meta": {
			"hash": "6488308725c46c512b036773a45036dee5b317312760e99314bbe019f348333a",
			"value": "Python · Sommer 2025"
