	"politica-cookies": {
		"meta/title": {
			"hash": "ff391c80c7c82b6e63ef6862086a634a00d621baebbddac3ab4e12893eee676b",
			"value": "కుకీల విధానం — Mario Álvarez"
		},
		"meta/description": {
			"hash": "a4f1a476b3200cd52b729560395661f0add1021d3e2e56acd524b4a0150335c7",
			"value": "ఈ సైట్ ఏ కుకీలను ఉపయోగిస్తుంది, ఏ ప్రయోజనం కోసం మరియు మీ సమ్మతిని ఎప్పుడైనా ఎలా మార్చుకోవచ్చు."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "లీగల్"
		},
		"meta/heading": {
			"hash": "e4124618327d933ffeb091afc88ab0a14227ed69e83aaf285ca403866111d3eb",
			"value": "కుకీల విధానం"
		},
		"bloques/0/texto": {
			"hash": "df0b70813839255ba6f0aef16202c89953164136f2532b92425c91beee04b8fb",
			"value": "ఈ వెబ్‌సైట్ సరిగ్గా పనిచేయడానికి మరియు మీరు సమ్మతిస్తే, కంటెంట్ ఎలా ఉపయోగించబడుతుందో అజ్ఞాతంగా విశ్లేషించడానికి కుకీలు మరియు ఇలాంటి సాంకేతికతలను (బ్రౌజర్ లోకల్ స్టోరేజ్ వంటివి) ఉపయోగిస్తుంది."
		},
		"bloques/1/texto": {
			"hash": "e940e1ef985d9395730ef5290b220f2331274816823e76bcc7e0be58cc291f87",
			"value": "ఉపయోగించే కుకీలు:"
		},
		"bloques/2/columnas/0": {
			"hash": "562bb15757a8b593d6fdc812b0767c0e198bf7d8e19157933110de09c9db9012",
			"value": "పేరు"
		},
		"bloques/2/columnas/1": {
			"hash": "25c2d36c49812b71d0b8d2b43de364c4b8b82606701a7d08e5eade99d9af667c",
			"value": "ప్రయోజనం"
		},
		"bloques/2/columnas/2": {
			"hash": "3868d2843d5924c192e2f8e32700b6df9b50769ab3dcf5839607c4657a1c4162",
			"value": "రకం"
		},
		"bloques/2/columnas/3": {
			"hash": "d5a804455b3392ca88333e92191b96b51f59b644511a73ee3d478fb14d9175d5",
			"value": "వ్యవధి"
		},
		"bloques/2/filas/0/0": {
			"hash": "9b9d58a5d3bd23f1a527509516e0adf5e5be9ed502640fcc0149e8e428d98ca8",
			"value": "consentimiento_cookies"
		},
		"bloques/2/filas/0/1": {
			"hash": "526746432ab0b8216448dc3f4f9aa90177641e413c0f362412c8607a0ad58c60",
			"value": "కుకీల విధానంపై మీ ఎంపికను గుర్తుంచుకోవడం"
		},
		"bloques/2/filas/0/2": {
			"hash": "e3c9d33af46786951131d096bfd0afca7a45113c203ff264ee3cafb667709165",
			"value": "స్వంతం, సాంకేతిక (సమ్మతి నుండి మినహాయించబడింది)"
		},
		"bloques/2/filas/0/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 నెలలు"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitante_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "మీ సందర్శనలను లింక్ చేయడానికి మరియు ఏ కంటెంట్ ఉపయోగకరంగా ఉందో తెలుసుకోవడానికి అజ్ఞాత గుర్తింపు"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "స్వంతం, విశ్లేషణాత్మక (మీ సమ్మతి అవసరం)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 నెలలు"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "ఈ కుకీలలో ఏవీ థర్డ్-పార్టీకి చెందినవి కావు, ప్రకటనల ప్రయోజనాల కోసం ఉపయోగించబడవు మరియు ఈ సైట్ వెలుపల ఎవరితోనూ భాగస్వామ్యం చేయబడవు."
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "ఫుటర్‌లోని \"కుకీలను కాన్ఫిగర్ చేయండి\" లింక్ నుండి మీరు ఎప్పుడైనా మీ నిర్ణయాన్ని మార్చుకోవచ్చు లేదా మీ సమ్మతిని ఉపసంహరించుకోవచ్చు మరియు అదే ప్యానెల్‌లోని \"నా డేటాను తొలగించు\" బటన్‌తో మీ డేటాను వెంటనే తొలగించవచ్చు."
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "మీ డేటా ఎలాగో పరిశీలించబడుతుందనే దాని గురించి మరింత సమాచారం కోసం, గోప్యతా విధానాన్ని చూడండి."
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "గోప్యతా విధానం — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez సైట్ యొక్క గోప్యతా విధానం: ఏ డేటా సేకరించబడుతుంది, ఏ ప్రయోజనం కోసం మరియు మీ హక్కులను ఎలా ఉపయోగించుకోవాలి."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "చట్టపరమైనది"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "గోప్యతా విధానం"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. డేటా కంట్రోలర్"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, বেনিদর্ভ (അലிக্যান্ট), ஸ்பெயின் இல் முகவரியைக் கொண்டுள்ளார். தொடர்பு: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. ప్రాసెసింగ్ యొక్క ప్రయోజనం"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "ఈ వెబ్‌సైట్ దాని కంటెంట్‌ను మెరుగుపరిచే లక్ష్యంతో, సందర్శకులకు ఏ కంటెంట్ (విభాగాలు, ప్రాజెక్ట్‌లు) అత్యంత ఉపయోగకరంగా ఉందో అంతర్గతంగా మరియు ప్రత్యేకంగా గణాంక ప్రయోజనాల కోసం విశ్లేషిస్తుంది. ఇది ప్రకటనల ప్రయోజనాల కోసం ఉపయోగించబడదు, మూడవ पक्षాలతో భాగస్వామ్యం చేయబడదు మరియు ఏ పరిస్థితులలోనూ విక్రయించబడదు."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. సేకరించబడిన డేటా (విశ్లేషణాత్మక కుక్కీలను మీరు అంగీకరిస్తే మాత్రమే)"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "యాదృచ్ఛిక అనామక ఐడెంటిఫైయర్, మీ పేరు, ఇమెయిల్ లేదా మిమ్మల్ని నేరుగా గుర్తించే ఇతర సమాచారంతో లింక్ చేయబడలేదు."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "మీరు సందర్శించే పేజీలు మరియు ప్రాజెక్ట్‌లు, మరియు ప్రతిదానిపై శ్రద్ధ పెట్టే సమయం (టాబ్ యాక్టివ్‌గా ఉన్నప్పుడు)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "పరస్పర చర్యలు (ప్రాజెక్ట్‌లు, లింక్‌లు లేదా బటన్‌లపై క్లిక్‌లు)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "సందర్శన తేదీ మరియు సమయం."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "సందర్శించిన సైట్ యొక్క భాష."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "పరికర రకం (మొబైల్ లేదా డెస్క్‌టాప్)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "మీ IP చిరునామాను నిల్వ చేయకుండా, Cloudflare ఇన్‌ఫ్రాస్ట్రక్చర్ ద్వారా పొందబడిన సుమారు దేశం."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "మూల పేజీ (ఉదాహరణకు, LinkedIn లేదా సెర్చ్ ఇంజిన్)."
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "మీ IP చిరునామా సేకరించబడదు, బ్రౌజర్ ఐడెంటిఫికేషన్ టెక్నిక్స్ (ఫింగర్‌ప్రింటింగ్) ఉపయోగించబడవు మరియు Google Analytics లేదా సరూపమైన మూడవ పక్ష సాధనాలు ఉపయోగించబడవు."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. చట్టపరమైన ఆధారం"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "ఈ ప్రాసెసింగ్ మీ స్పష్టమైన సమ్మతిపై ఆధారపడి ఉంటుంది (RGPD యొక్క ఆర్టికల్ 6.1.a మరియు LSSI-CE యొక్క ఆర్టికల్ 22.2), సైట్ యొక్క కుక్కీ మేనేజర్ నుండి మీరు ఎప్పుడైనా దీనిని ఉపసంహరించుకోవచ్చు."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. నిలుపుదల కాలం"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "డేటా మీ చివరి సందర్శన నుండి గరిష్టంగా 12 నెలల పాటు నిల్వ చేయబడుతుంది, ఆ తర్వాత అది స్వయంచాలకంగా తొలగించబడుతుంది."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. గ్రహీతలు మరియు అంతర్జాతీయ బదిలీలు"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "డేటా మూడవ पक्षాలకు అందించబడదు లేదా విక్రయించబడదు. ఇది ప్రాసెసర్‌గా పనిచేసే Cloudflare, Inc. అందించే డేటాబేస్ సేవ అయిన Cloudflare D1 లో నిల్వ చేయబడుతుంది. Cloudflare యూరోపియన్ ఎకనామిక్ ఏరియా వెలుపల డేటాను ప్రాసెస్ చేయవచ్చు; ఆ సందర్భంలో, అటువంటి బదిలీ యూరోపియన్ కమిషన్ ఆమోదించిన ప్రామాణిక ఒప్పంద నిబంధనల ద్వారా రక్షించబడుతుంది. మరింత సమాచారం Cloudflare గోప్యతా విధానంలో ఉంది: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. మీ హక్కులు"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "malvmar5@hotmail.com కు వ్రాయడం ద్వారా మీరు ఎప్పుడైనా మీ యాక్సెస్, దిద్దుబాటు, తొలగింపు, వ్యతిరేకత, ప్రాసెసింగ్ పరిమితి మరియు పోర్టబిలిటీ హక్కులను ఉపయోగించుకోవచ్చు. అదనంగా, సైట్ యొక్క కుక్కీ కాన్ఫిగరేషన్‌లో అందుబాటులో ఉన్న \"నా డేటాను తొలగించు\" బటన్ నుండి ఎవరికీ వ్రాయవలసిన అవసరం లేకుండా మీరు మీ డేటాను వెంటనే తొలగించవచ్చు. మీ హక్కులు సరిగ్గా నెరవేరలేదని మీరు భావిస్తే, స్పానిష్ డేటా ప్రొటెక్షన్ ఏజెన్సీ (www.aepd.es)కి ఫిర్యాదు చేసే హక్కు కూడా మీకు ఉంది."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. ఈ విధానంలో మార్పులు"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "చట్టపరమైన మార్పులకు లేదా సైట్ యొక్క స్వంత మార్పులకు అనుగుణంగా ఈ విధానం నవీకరించబడవచ్చు."
		}
	}
}
