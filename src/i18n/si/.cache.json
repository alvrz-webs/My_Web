		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "දත්ත තෙවන පාර්ශවයන්ට ලබා දීම හෝ විකිණීම සිදු නොකෙරේ. ඒවා සැකසුම්කරු ලෙස ක්‍රියා කරන Cloudflare, Inc. විසින් සපයන ලද දත්ත සමුදා සේවාවක් වන Cloudflare D1 හි ගබඩා කර ඇත. Cloudflare හට යුරෝපා ආර්ථික ප්‍රදේශයෙන් පිටත දත්ත සැකසිය හැක; එම අවස්ථාවේදී, එවැනි මාරු කිරීමක් යුරෝපා කොමිසම විසින් අනුමත කරන ලද සම්මත කොන්ත්‍රාත් වගන්ති මගින් ආවරණය කරනු ලැබේ. වැඩි විස්තර Cloudflare හි රහස්‍යතා ප්‍රතිපත්තියෙන්: https://www.cloudflare.com/privacypolicy/"
		},
