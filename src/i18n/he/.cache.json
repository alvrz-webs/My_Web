	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "אודותי — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "אלוף ספרד במדיסון לשעבר שהפך לסטודנט למדעי הנתונים: המסע של Mario Álvarez בין רכיבת אופניים עילית לניתוח ספורט."
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "אודותי"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "מהוולודרום אל הנתונים"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "התחלתי כמתחרה. בגיל 18 הוכרזתי כאלוף ספרד במדיסון במסלול, ונבחרת ספרד ברכיבת אופניים זימנה אותي לאליפויות העולם והאירופה, שם סיימתי במקום השישי בשתיהן, מה שהקנה לי מעמד של ספורטאי עילית."
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "משם עברתי למדעי הנתונים: כיום אני סטודנט שנה ג' לתואר ראשון ב-Universitat Politècnica de València, הממוקד בדיגיטליזציה וטכנולוגיה המיושמות בספורט."
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "הערך המוסף שלי הוא הגשר הזה: חוויתי ביצועי שיא מבפנים — כרוכב, כמנהל ספורטיבי של מחלקות נוער וכמעסה ספורט של רוכבים מקצועיים — ואני יודע לקרוא את הנתונים שעומדים מאחוריהם. אני מבין מה מספר אומר לספורטאי, כי הייתי הספורטאי הזה. אני מחבר את שני העולמות כדי להפוך נתונים להחלטות שמשפרות ביצועים."
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "בנוסף, הודות למעמدي כספורטאי עילית, זכיתי במלגה ללימודי תואר שני בדיגיטליזציה, חדשנות וטכנולוגיה בספורט, שאותם כבר סיימתי ושמרחיבים את נקודת המבט שלי על כל אקוסיסטם הספורט, מעבר לרכיבת אופניים."
		},
