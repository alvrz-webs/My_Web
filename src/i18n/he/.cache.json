		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "הנדסת נתונים · בנידורם · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME מפתخة תוכנות ניהול (הזמנות, חיובים, דוחות, הזמנות מסעדה) המשרתות מאות לקוחות ממערכת מרכזית, על בסיס נתונים של למעלה מ-580 טבלאות מקושרות ולמעלה מ-100 מיליון רשומות. הצמיחה חייבה חלוקת לקוחות למספר בסיסי נתונים כדי להקל על העומס ותלונות על איטיות."
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "העבודה שלי: ניתוח בסיסי נתונים אלו, ובאמצעות אופטימיזציה של שאילתות ואינדקסים, תכנון איחוד כל הנתונים בבסיס נתונים יעיל יחיד כמעט ללא הרחבת חומרת השררת (RAM/CPU). שיפור שכבר פותח, בשלב ולידציה על שרת בדיקות."
		},
