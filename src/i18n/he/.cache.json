		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "אף אחת מעוגיות אלו אינה של צד שלישי, אף אחת אינה בשימוש למטרות פרסום, ואף אחת אינה משותפת עם אף אחד מחוץ לאתר זה."
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "באפשרותך לשנות את החלטתך או למשוך את הסכמתך בכל עת מקישור \"הגדרת עוגיות\" בכותרת התחתונה, ולמחק באופן מיידי את כל הנתונים שלך באמצעות לחצן \"מחק את הנתונים שלי\" באותו לוח."
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "למידע נוסף על אופן הטיפול בנתונים שלך, עיין במדיניות הפרטיות."
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "מדיניות פרטיות — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "מדיניות הפרטיות של האתר של Mario Álvarez: אילו נתונים נאספים, לאיזו מטרה וכיצד לממש את זכויותיך."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "משפטי"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "מדיניות הפרטיות"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. אחראי על עיבוד הנתונים"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, בעל כתובת בבנידורם (אליקנטה), ספרד. איש קשר: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. מטרת עיבוד הנתונים"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "אתר זה מנתח באופן פנימי ולמטרות סטטיסטיות בלבד אילו תכנים (מדורים, פרויקטים) שימושיים ביותר למבקרים בו, במטרה לשפר את תוכנו. הוא אינו משמש למטרות פרסום, אינו משתף עם צדדים שלישיים ואינו נמכר בשום נסיבות."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. נתונים הנאספים (רק אם אתה מאשר את קובצי ה-Cookie האנליטיים)"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "מזהה אנונימי אקראי, שאינו קשור לשמך, לדוא\"ל שלך או לכל מידע אחר שמזהה אותך ישירות."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "דפים ופרויקטים שאתה מבקר בהם, וזמן השהייה בכל אחד מהם (כל עוד הלשונית פעילה)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "אינטראקציות (לחיצות על פרויקטים, קישורים או כפתורים)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "תאריך ושעה של הביקור."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "שפת האתר שבה נצפה."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "סוג המכשיר (נייד או שולחני)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "מדינה מקורבת, המושגת באמצעות תשתית Cloudflare, מבלי לאחסן את כתובת ה-IP שלך."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "דף המקור (למשל, LinkedIn או מנוע חיפוש)."
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "כתובת ה-IP שלך אינה נאספת, אין שימוש בטכניקות זיהוי דפדפן (fingerprinting), ואין שימוש בכלים של צד שלישי כמו Google Analytics או דומים."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. בסיס משפט"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "העיבוד מבוסס על הסכמתך המפורשת (סעיף 6.1.a של GDPR וסעיף 22.2 של LSSI-CE), אותה תוכל למשוך בכל עת ממנהל קובצי ה-Cookie של האתר עצמו."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. תקופת שמירת הנתונים"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "הנתונים נשמרים למשך מקסימום 12 חודשים מביקורך האחרון, ולאחר מכן הם נמחקים אוטומטית."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. נמענים והעברות בינלאומיות"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "הנתונים אינם נמסרים או נמכרים לצדדים שלישיים. הם מאוחסנים ב-Cloudflare D1, שירות מסד נתונים המסופק על ידי Cloudflare, Inc., המשמש כמנהל העיבוד. Cloudflare עשויה לעבד נתונים מחוץ לאזור הכלכלי האירופי; במקרה זה, העברה זו מוגנת על ידי סעיפים חוזיים סטנדרטיים שאושרו על ידי הנציבות האירופית. מידע נוסף במדיניות הפרטיות של Cloudflare: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. הזכויות שלך"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "תוכל לממש בכל עת את זכויותיך לעיון, תיקון, מחיקה, התנגדות, הגבלת עיבוד וניוד על ידי כתיבה לכתובת malvmar5@hotmail.com. בנוסף, תוכל למחוק את הנתונים שלך באופן מיידי, ללא צורך לכתוב لأיש, מהכפתור \"מחק את הנתונים שלי\" הזמין בהגדרות קובצי ה-Cookie של האתר. יש לך גם זכות להגיש תלונה לסוכנות הספרדית הגנה על פרטיות (www.aepd.es) אם אתה סבור שזכויותיך לא טופלו כראוי."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. שינויים במדיניות זו"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "מדיניות זו עשויה להתעדכן כדי להתאים לשינויים משפטיים או של האתר עצמו."
		}
	}
}
