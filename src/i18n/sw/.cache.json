	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "Kuhusu mimi — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "Kutoka bingwa wa Uhispania wa madison hadi mwanafunzi wa Sayansi ya Data: safari ya Mario Álvarez kati ya baiskeli ya kiwango cha juu na uchambuzi wa michezo."
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "Kuhusu mimi"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "Kutoka uwanja wa baiskeli hadi data"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "Nilianza kushindana. Akiwa na miaka 18 nilikuwa bingwa wa Uhispania wa madison kwenye njia na Timu ya Taifa ya Baiskeli ya Uhispania iliniita kwa ajili ya Mashindano ya Dunia na ya Ulaya, ambapo nilikuwa wa sita katika yote mawili, jambo ambalo lilinipa hadhi ya mwanamichezo wa kiwango cha juu."
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "Kutoka hapo nilifanya kuruka hadi Sayansi ya Data: leo ninasoma mwaka wa 3 wa Digrii katika Universitat Politècnica de València, inayolenga uwekaji dijiti na teknolojia inayotumika kwenye michezo."
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "Thamani yangu ya kipekee ni daraja hilo: nimeishi utendaji wa juu kutoka ndani — kama mkimbiaji, kama mkurugenzi wa michezo wa msingi na kama mtaalamu wa masaji ya michezo kwa wanariadha wataalamu — na najua jinsi ya kusoma data iliyo nyuma. Ninaelewa kile nambari inamaanisha kwa mwanamichezo, kwa sababu nimekuwa mwanamichezo huyo. Ninaunganisha ulimwengu huo mbili ili kugeuza data kuwa maamuzi yanayoboresha utendaji."
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "Zaidi ya hayo, kutokana na hali yangu kama mwanamichezo wa kiwango cha juu, nilipata ufadhili wa masomo wa kusoma Shahada ya Uzamili katika Uwekaji Dijiti, Ubunifu na Teknolojia katika Michezo, ambayo nimeshakamilisha na ambayo inapanua mtazamo wangu kwa mfumo mzima wa ikolojia wa michezo, zaidi ya baiskeli."
		},
		"facts/0/label": {
			"hash": "7b47361aad19bb483aeab081a7df0a55f7cb0fdb3327efe6dd016e6353a17880",
