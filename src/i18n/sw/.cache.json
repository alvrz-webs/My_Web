		"datos/1/paragraphs/0": {
			"hash": "88812d1a8e39e12980bd0aad35d319151c4b34517b3fea94b689926ea882db75",
			"value": "Mradi binafsi nilioufanya kama jaribio la kupata nafasi ya uchambuzi wa data katika michezo ya baiskeli ya kitaalamu:"
		},
		"datos/1/list/0": {
			"hash": "15b3ec38dc8dfa12d8b1316799dfa877540922c75f5393652d8222fc34cf9f32",
			"value": "Kipima ugumu cha UCI: kupitia uchimbaji data wa mtandao wa viwango vya UCI, kinaweka wachezaji wa timu na kukadiria kiwango cha ugumu cha kupata alama za UCI kulingana na kikosi."
		},
		"datos/1/list/1": {
			"hash": "d35542e142f04b315824ed35881fbc8bdeab4f6efe42052aa25af7ccf9219a06",
			"value": "Tabiri ya wasifu wa mashindano: inatarajia sifa za kila mashindano na kuweka alama ya ugumu ili kupanga malengo na mikakati."
		},
		"datos/2/title": {
			"hash": "6d6d9b9c6b1106b6be84b18aa1c031065f3a79ae1d253f8a2de353d153b9c20d",
