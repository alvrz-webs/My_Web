			"value": "Data na Teknolojia"
		},
		"meta/colDeporte": {
			"hash": "663be1ebba5f3d435a2ed6113e5483f7d94a2c384cb631a57a3372474d9c2856",
			"value": "Michezo ya Kiwango cha Juu"
		},
		"datos/0/title": {
			"hash": "13cef0dcb61fc73058ec321707889f11b0168613745fa04b982101456aea1628",
			"value": "SIME TELECOM — Mafunzo ya Sayansi ya Data"
		},
		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "Uhandisi wa Data · Benidorm · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME hutengeneza programu za usimamizi (uhifadhi, utozaji, ripoti, maagizo ya mikahawa) ambazo zinahudumia mamia ya wateja kutoka mfumo mkuu, kwenye hifadhidata ya zaidi ya majedwali 580 yaliyounganishwa na zaidi ya rekodi milioni 100. Ukuaji ulikuwa umelazimu kugawanya wateja katika hifadhidata kadhaa ili kupunguza mzigo na malalamiko ya polepole."
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "Kazi yangu: kuchambua hifadhidata hizo na, kupitia uboreshaji wa maswali na fahirisi, kubuni muunganisho wa data zote katika hifadhidata moja yenye ufanisi bila kuongeza karibu rasilimali za kompyuta (RAM/CPU). Uboreshaji tayari umesanifiwa, ukiwa katika hatua ya uthibitishaji kwenye seva ya majaribio."
		},
		"datos/1/title": {
			"hash": "713d758668b5870715b25afdbd2943093657f8f79038522da209181e9032bfb2",
			"value": "Miradi na timu ya Cofidis (World Tour)"
		},
		"datos/1/meta": {
