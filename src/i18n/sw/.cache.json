		"deporte/0/title": {
			"hash": "aeaf5051b84ddf9e892f45b118553a28bd15f4a82ffc13357946c8cb768bce4c",
			"value": "Mashindano"
		},
		"deporte/0/paragraphs/0": {
			"hash": "431d7654ad9c17cfef188c6dd216d77877c67074b5a70fccc26b28faecb96342",
			"value": "Bingwa wa Uhispania wa madison (miaka 18); Kombe la Dunia na Uropa la uwanjani na Timu ya Taifa ya Uhispania (wa 6 katika zote mbili); mwanariadha wa kiwango cha juu; mwendesha baiskeli wa uwanjani aliyesajiliwa na anayeshiriki kikamilifu."
		},
		"deporte/1/title": {
			"hash": "84790bf295460a6481da8ad76c8e18d330f20f20baefb8c4d37a1818f065b8a5",
			"value": "Usimamizi wa michezo"
		},
		"deporte/1/paragraphs/0": {
			"hash": "5dc31dcec5b8544c3fc67da4aedaf52f4da758ba225c9b41297dbeb77730d51b",
			"value": "Mkurugenzi wa Michezo Ngazi ya I na II (RFEC); mafunzo na ufuatiliaji wa wanariadha wa vijana (14–18) pamoja na baba yangu; msaidizi wa Timu ya Taifa ya Jumuiya ya Valencia katika mashindano (2026)."
		},
		"deporte/2/title": {
			"hash": "0cfe14a47563f418eb121ade7cad7186d2ee23873832ee8f81b43b56f8c18212",
			"value": "Tiba ya masaji na wafanyakazi wa ufundi"
		},
		"deporte/2/meta": {
			"hash": "907fae24556078db9b490356a39c8eba0b3c8f124cc2f6172d189ab43f6f3d1a",
			"value": "Majira ya joto 2025"
		},
		"deporte/2/paragraphs/0": {
			"hash": "c46a0525722fd6b77650f20d6fcb485187aa219ea1b9064462a9b8b533f75a83",
			"value": "Mtaalamu wa tiba ya masaji; mtaalamu wa masaji wa waendesha baiskeli wa kitaalamu; mfanyakazi wa ufundi na Timu ya Taifa ya Jumuiya ya Valencia, na timu ya bara ya Ufilipino na na wanariadha binafsi huko Benidorm."
		}
	},
