	"experiencia": {
		"meta/title": {
			"hash": "53e146e44dcc62fdf154b05e8558ed180494224b34f8151d9da9835ab6262133",
			"value": "Uzoefu — Mario Álvarez"
		},
		"meta/description": {
			"hash": "f2b25552e0b9b597bdbb674ccf1b3749d55af30a1434e173f2449fc1156a8996",
			"value": "Ulimwengu miwili, lugha moja: utendaji. Uzoefu wa Mario Álvarez katika data na uhandisi, na katika michezo ya baiskeli ya kiwango cha juu."
		},
		"meta/eyebrow": {
			"hash": "2dba6bf7c79f75d22c710e160206dec6460bf0b4509e0afe4778cd89f98e4f68",
