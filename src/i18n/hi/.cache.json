	"politica-cookies": {
		"meta/title": {
			"hash": "ff391c80c7c82b6e63ef6862086a634a00d621baebbddac3ab4e12893eee676b",
			"value": "कुकी नीति — Mario Álvarez"
		},
		"meta/description": {
			"hash": "a4f1a476b3200cd52b729560395661f0add1021d3e2e56acd524b4a0150335c7",
			"value": "यह साइट किस कुकीज़ का उपयोग करती है, किस उद्देश्य के लिए और किसी भी समय अपनी सहमति कैसे बदलें।"
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कानूनी"
		},
		"meta/heading": {
			"hash": "e4124618327d933ffeb091afc88ab0a14227ed69e83aaf285ca403866111d3eb",
			"value": "कुकी नीति"
		},
		"bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "अनुच्छेद"
		},
		"bloques/0/texto": {
			"hash": "df0b70813839255ba6f0aef16202c89953164136f2532b92425c91beee04b8fb",
			"value": "यह वेबसाइट इसके सही संचालन के लिए और यदि आप सहमति देते हैं, तो सामग्री का उपयोग कैसे किया जाता है, इसका गुमनाम रूप से विश्लेषण करने के लिए कुकीज़ और इसी तरह की तकनीकों (जैसे ब्राउज़र लोकल स्टोरेज) का उपयोग करती है।"
		},
		"bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "अनुच्छेद"
		},
		"bloques/1/texto": {
			"hash": "e940e1ef985d9395730ef5290b220f2331274816823e76bcc7e0be58cc291f87",
			"value": "उपयोग की जाने वाली कुकीज़:"
		},
		"bloques/2/tipo": {
			"hash": "4a106a9d5ab0bb93b5b43a631db37df385a14c174875bea35bf244e5f35eedc8",
			"value": "तालिका"
		},
		"bloques/2/columnas/0": {
			"hash": "562bb15757a8b593d6fdc812b0767c0e198bf7d8e19157933110de09c9db9012",
			"value": "नाम"
		},
		"bloques/2/columnas/1": {
			"hash": "25c2d36c49812b71d0b8d2b43de364c4b8b82606701a7d08e5eade99d9af667c",
			"value": "उद्देश्य"
		},
		"bloques/2/columnas/2": {
			"hash": "3868d2843d5924c192e2f8e32700b6df9b50769ab3dcf5839607c4657a1c4162",
			"value": "प्रकार"
		},
		"bloques/2/columnas/3": {
			"hash": "d5a804455b3392ca88333e92191b96b51f59b644511a73ee3d478fb14d9175d5",
			"value": "अवधि"
		},
		"bloques/2/filas/0/0": {
			"hash": "9b9d58a5d3bd23f1a527509516e0adf5e5be9ed502640fcc0149e8e428d98ca8",
			"value": "cookie_consent"
		},
		"bloques/2/filas/0/1": {
			"hash": "526746432ab0b8216448dc3f4f9aa90177641e413c0f362412c8607a0ad58c60",
			"value": "इस कुकी नीति के बारे में आपकी पसंद को याद रखना"
		},
		"bloques/2/filas/0/2": {
			"hash": "e3c9d33af46786951131d096bfd0afca7a45113c203ff264ee3cafb667709165",
			"value": "स्वयं की, तकनीकी (सहमति से मुक्त)"
		},
		"bloques/2/filas/0/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 महीने"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitor_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "आपकी मुलाकातों को जोड़ने और यह जानने के लिए गुमनाम पहचानकर्ता कि कौन सी सामग्री उपयोगी है"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "स्वयं की, विश्लेषणात्मक (आपकी सहमति की आवश्यकता है)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 महीने"
		},
		"bloques/3/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "अनुच्छेद"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "इनमें से कोई भी कुकी थर्ड-पार्टी की नहीं है, न ही किसी का उपयोग विज्ञापन उद्देश्यों के लिए किया जाता है, और न ही इस साइट के बाहर किसी के साथ साझा किया जाता है।"
		},
		"bloques/4/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "अनुच्छेद"
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "आप फ़ुटर में \"कुकीज़ कॉन्फ़िगर करें\" लिंक से किसी भी समय अपना निर्णय बदल सकते हैं या अपनी सहमति वापस ले सकते हैं, और उसी पैनल में \"मेरा डेटा हटाएं\" बटन के साथ अपने सभी डेटा को तुरंत हटा सकते हैं।"
		},
		"bloques/5/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "अनुच्छेद"
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "आपके डेटा पर कैसे प्रक्रिया की जाती है, इस बारे में अधिक जानकारी के लिए, गोपनीयता नीति देखें।"
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "गोपनीयता नीति — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez की साइट की गोपनीयता नीति: कौन सा डेटा एकत्र किया जाता है, किस उद्देश्य के लिए और अपने अधिकारों का उपयोग कैसे करें।"
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कानूनी"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "गोपनीयता नीति"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. डेटा नियंत्रक"
		},
		"secciones/0/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, बेनिडॉर्म (एलिकांटे), स्पेन में स्थित। संपर्क: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. प्रसंस्करण का उद्देश्य"
		},
		"secciones/1/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "यह वेबसाइट आंतरिक रूप से और विशेष रूप से सांख्यिकीय उद्देश्यों के लिए विश्लेषण करती है कि कौन सी सामग्री (अनुभाग, प्रोजेक्ट) आगंतुकों के लिए सबसे अधिक उपयोगी हैं, जिसका उद्देश्य इसकी सामग्री में सुधार करना है। इसका उपयोग विज्ञापन उद्देश्यों के लिए नहीं किया जाता है, इसे तीसरे पक्ष के साथ साझा नहीं किया जाता है और किसी भी परिस्थिति में बेचा नहीं जाता है।"
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. एकत्र किया गया डेटा (केवल यदि आप विश्लेषणात्मक कुकीज़ स्वीकार करते हैं)"
		},
		"secciones/2/bloques/0/tipo": {
			"hash": "0296c43c240aa12c0950ff03ab0ebe09a1762b6600266e122f9c4b4099f72359",
			"value": "lista"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "एक यादृच्छिक अज्ञात पहचानकर्ता, जो आपके नाम, ईमेल या आपको सीधे पहचानने वाली किसी अन्य जानकारी से जुड़ा नहीं है।"
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "पेज और प्रोजेक्ट जिन पर आप जाते हैं, और प्रत्येक पर ध्यान देने का समय (जब टैब सक्रिय हो)।"
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "इंटरैक्शन (प्रोजेक्ट, लिंक या बटन पर क्लिक)।"
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "यात्रा की तिथि और समय।"
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "परामर्श की गई साइट की भाषा।"
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "डिवाइस का प्रकार (मोबाइल या डेस्कटॉप)।"
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "आपके IP पते को संग्रहीत किए बिना, Cloudflare बुनियादी ढांचे के माध्यम से प्राप्त अनुमानित देश।"
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "उत्पत्ति का पेज (उदाहरण के लिए, LinkedIn या एक खोज इंजन)।"
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "आपका IP पता एकत्र नहीं किया जाता है, ब्राउज़र पहचान तकनीकों (fingerprinting) का उपयोग नहीं किया जाता है, और Google Analytics या समान जैसे तीसरे पक्ष के टूल का उपयोग नहीं किया जाता है।"
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. कानूनी आधार"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "प्रसंस्करण आपकी स्पष्ट सहमति पर आधारित है (GDPR के अनुच्छेद 6.1.a और LSSI-CE के अनुच्छेद 22.2), जिसे आप साइट के स्वयं के कुकी प्रबंधक से किसी भी समय वापस ले सकते हैं।"
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. प्रतिधारण अवधि"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "डेटा को आपकी अंतिम यात्रा से अधिकतम 12 महीने तक रखा जाता है, जिसके बाद उन्हें स्वचालित रूप से हटा दिया जाता है।"
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. प्राप्तकर्ता और अंतर्राष्ट्रीय स्थानांतरण"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "डेटा को तीसरे पक्ष को न तो हस्तांतरित किया जाता है और न ही बेचा जाता है। इसे Cloudflare D1 में संग्रहीत किया जाता है, जो Cloudflare, Inc. द्वारा प्रदान की जाने वाली एक डेटाबेस सेवा है, जो एक डेटा प्रोसेसर के रूप में कार्य करती है। Cloudflare यूरोपीय आर्थिक क्षेत्र के बाहर डेटा को संसाधित कर सकता है; उस स्थिति में, ऐसा स्थानांतरण यूरोपीय आयोग द्वारा अनुमोदित मानक संविदात्मक खंडों द्वारा संरक्षित है। Cloudflare की गोपनीयता नीति में अधिक जानकारी: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. आपके अधिकार"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "आप malvmar5@hotmail.com पर लिखकर किसी भी समय पहुंच, सुधार, विलोपन, विरोध, प्रसंस्करण की सीमा और पोर्टेबिलिटी के अपने अधिकारों का प्रयोग कर सकते हैं। इसके अलावा, आप साइट की कुकी सेटिंग्स में उपलब्ध \"मेरा डेटा हटाएं\" बटन से किसी को लिखे बिना, तुरंत अपना डेटा हटा सकते हैं। यदि आपको लगता है कि आपके अधिकारों को ठीक से संबोधित नहीं किया गया है, तो आपको स्पेनिश डेटा संरक्षण एजेंसी (www.aepd.es) के समक्ष शिकायत दर्ज करने का भी अधिकार है।"
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. इस नीति में परिवर्तन"
		},
		"secciones/7/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "कानूनी परिवर्तनों या साइट के अपने परिवर्तनों के अनुकूल होने के लिए इस नीति को अपडेट किया जा सकता है।"
		}
	}
}
