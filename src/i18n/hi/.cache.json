		"datos/0/title": {
			"hash": "13cef0dcb61fc73058ec321707889f11b0168613745fa04b982101456aea1628",
			"value": "SIME TELECOM — डेटा साइंस इंटर्नशिप"
		},
		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "डेटा इंजीनियरिंग · बेनिडोर्म · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME प्रबंधन सॉफ्टवेयर (बुकिंग, बिलिंग, रिपोर्ट, रेस्तरां ऑर्डर) विकसित करता है जो एक केंद्रीय प्रणाली से सैकड़ों ग्राहकों को सेवा प्रदान करता है, जो +580 परस्पर जुड़ी तालिकाओं और +100 मिलियन रिकॉर्ड के डेटाबेस पर आधारित है। वृद्धि के कारण लोड को कम करने और धीमी गति की शिकायतों को दूर करने के लिए ग्राहकों को कई डेटाबेस में बांटना पड़ा था।"
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "मेरा काम: उन डेटाबेस का विश्लेषण करना और, क्वेरी ऑप्टिमाइज़ेशन और इंडेक्स के माध्यम से, हार्डवेयर (RAM/CPU) को मुश्किल से बढ़ाए बिना सभी डेटा को एक एकल कुशल डेटाबेस में एकीकृत करने की रूपरेखा तैयार करना। यह सुधार पहले ही विकसित किया जा चुका है, और परीक्षण सर्वर पर सत्यापन के चरण में है।"
		},
		"datos/1/title": {
			"hash": "713d758668b5870715b25afdbd2943093657f8f79038522da209181e9032bfb2",
			"value": "Cofidis (World Tour) टीम के साथ प्रोजेक्ट"
		},
		"datos/1/meta": {
			"hash": "6488308725c46c512b036773a45036dee5b317312760e99314bbe019f348333a",
			"value": "Python · ग्रीष्मकालीन 2025"
		},
		"datos/1/paragraphs/0": {
			"hash": "88812d1a8e39e12980bd0aad35d319151c4b34517b3fea94b689926ea882db75",
			"value": "स्वयं का प्रोजेक्ट जिसे मैंने पेशेवर साइकिलिंग में डेटा विश्लेषण तक पहुँचने के लिए एक परीक्षण के रूप में किया था:"
		},
		"datos/1/list/0": {
			"hash": "15b3ec38dc8dfa12d8b1316799dfa877540922c75f5393652d8222fc34cf9f32",
			"value": "UCI कठिनाई विश्लेषक: UCI रैंकिंग की वेब स्क्रैपिंग के माध्यम से, यह टीम के रेसर्स को स्थान देता है और रोस्टर के अनुसार UCI अंक प्राप्त करने के कठिनाई स्तर का अनुमान लगाता है।"
		},
		"datos/1/list/1": {
			"hash": "d35542e142f04b315824ed35881fbc8bdeab4f6efe42052aa25af7ccf9219a06",
			"value": "रेस प्रोफाइल प्रेडिक्टर: प्रत्येक रेस की विशेषताओं का अनुमान लगाता है और उद्देश्यों और रणनीति की योजना बनाने के लिए इसे कठिनाई अंक प्रदान करता है।"
		},
