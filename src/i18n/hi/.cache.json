		"sobreMiResumen/title": {
			"hash": "6210f2e44a03903aa5b0bea20e2d29f04b9a9ee5abc860781e046649f0067aaa",
			"value": "कोर्ट, सड़क और प्रतियोगिता के संदर्भ के साथ डेटा"
		},
		"sobreMiResumen/text": {
			"hash": "dad327cad1b7a9fd0fad2c312612e980b47320b4be9cb2c245f19d427e83cf14",
			"value": "मैं मारियो अल्वारेज़ हूँ, यूपीवी में डेटा साइंस का छात्र हूँ जिसके पास पेशेवर साइक्लिंग का वास्तविक अनुभव है। मैं प्रत्येक मेट्रिक्स को परिणामों में सुधार करने वाले निर्णय में बदलने के लिए डेटा विश्लेषण को एलीट स्पोर्ट्स प्रदर्शन के साथ जोड़ता हूँ।"
		},
