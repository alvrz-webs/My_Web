		},
		"experienciaResumen/eyebrow": {
			"hash": "2dba6bf7c79f75d22c710e160206dec6460bf0b4509e0afe4778cd89f98e4f68",
			"value": "अनुभव"
		},
		"experienciaResumen/title": {
			"hash": "077eeafeaba85ca233eb8c419d41076238aca8fc18a3d2d035b791607bcccc1a",
			"value": "दो दुनिया, एक ही भाषा: प्रदर्शन"
		},
		"experienciaResumen/text": {
			"hash": "fab92a26eae655346db1662eb8971457d54d58c22526368ec25b46ab46f46fee",
			"value": "मैंने उच्चतम स्तर पर प्रतिस्पर्धा की है और आज मैं डेटा पर भी वही मानदंड लागू करता हूँ: मैं समझता हूँ कि एक नंबर का एक खिलाड़ी के लिए क्या मतलब है क्योंकि मैं वह खिलाड़ी रहा हूँ।"
		},
		"ctaFinal/title": {
			"hash": "4f8488bbf0bfd5f01ce9eceb492dfd38151a6c58c043589aa86a0dbeeea289e0",
			"value": "क्या हम डेटा के बारे में बात करें?"
		},
		"ctaFinal/text": {
			"hash": "d03b92b93f54bdd2b6acaad1dfec53aac018610e7bcfc914c87162edf401a51f",
			"value": "मुझे अपना प्रोजेक्ट बताएं और हम मिलकर उन निर्णयों को ढूंढते हैं जो प्रदर्शन में सुधार करते हैं।"
		}
	},
	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "मेरे बारे में — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "स्पेनिश मैडिसन चैंपियन से लेकर डेटा साइंस के छात्र तक: एलीट साइक्लिंग और स्पोर्ट्स एनालिटिक्स के बीच Mario Álvarez की यात्रा।"
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "मेरे बारे में"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "वेलोड्रोम से डेटा तक"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "मैंने प्रतिस्पर्धा करना शुरू किया। 18 साल की उम्र में, मैं ट्रैक पर मैडिसन का स्पेनिश चैंपियन बना और स्पेनिश साइक्लिंग नेशनल टीम ने मुझे विश्व और यूरोपीय चैंपियनशिप के लिए बुलाया, जहाँ मैं दोनों में छठे स्थान पर रहा, जिससे मुझे एलीट एथलीट का दर्जा मिला।"
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "वहाँ से मैंने डेटा साइंस में कदम रखा: आज मैं Universitat Politècnica de València में डिग्री के तीसरे वर्ष में हूँ, जो खेल पर लागू डिजिटलीकरण और तकनीक पर केंद्रित है।"
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "मेरा अलग मूल्य वह सेतु है: मैंने अंदर से उच्च प्रदर्शन का अनुभव किया है - एक रेसर के रूप में, युवा खेल निदेशक के रूप में और पेशेवर साइकिल चालकों के स्पोर्ट्स मसाज थेरेपिस्ट के रूप में - और मैं इसके पीछे के डेटा को पढ़ना जानता हूँ। मैं समझता हूँ कि एक नंबर का एक एथलीट के लिए क्या मतलब होता है, क्योंकि मैं वह एथलीट रहा हूँ। मैं प्रदर्शन को बेहतर बनाने वाले निर्णयों में डेटा बदलने के लिए दोनों दुनिया को मिलाता हूँ।"
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "इसके अलावा, एक एलीट एथलीट के रूप में मेरी स्थिति के कारण, मुझे खेल में डिजिटलीकरण, नवाचार और प्रौद्योगिकी में मास्टर की पढ़ाई करने के लिए छात्रवृत्ति मिली, जिसे मैंने पूरा कर लिया है और जो साइक्लिंग से परे पूरे खेल पारिस्थितिकी तंत्र तक मेरे दृष्टिकोण को विस्तृत करती है।"
		},
