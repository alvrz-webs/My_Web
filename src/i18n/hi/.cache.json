			"value": "चiroमसाज और तकनीकी स्टाफ"
		},
		"deporte/2/meta": {
			"hash": "907fae24556078db9b490356a39c8eba0b3c8f124cc2f6172d189ab43f6f3d1a",
			"value": "ग्रीष्मकालीन 2025"
		},
		"deporte/2/paragraphs/0": {
			"hash": "c46a0525722fd6b77650f20d6fcb485187aa219ea1b9064462a9b8b533f75a83",
			"value": "प्रमाणित कायरोमासियूर; पेशेवर साइकिस्टों के masseur; वेलेंसियाई समुदाय की राष्ट्रीय टीम के साथ, एक फिलिपिनो महाद्वीपीय टीम के साथ और बेनिडोर्म में व्यक्तिगत रूप से साइकिस्टों के साथ स्टाफ।"
		}
	},
