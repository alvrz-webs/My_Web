		"experienciaResumen/title": {
			"hash": "077eeafeaba85ca233eb8c419d41076238aca8fc18a3d2d035b791607bcccc1a",
			"value": "दुई संसार, एउटै भाषा: प्रदर्शन"
		},
		"experienciaResumen/text": {
			"hash": "fab92a26eae655346db1662eb8971457d54d58c22526368ec25b46ab46f46fee",
			"value": "मैले उच्चतम स्तरमा प्रतिस्पर्धा गरेको छु र आज डाटामा पनि यही मापदण्ड लागू गर्छु: एउटा अंकले खेलाडीका लागि के अर्थ राख्छ भन्ने म बुझ्छु किनकि म आफैं त्यो खेलाडी भएको छु।"
		},
		"ctaFinal/title": {
			"hash": "4f8488bbf0bfd5f01ce9eceb492dfd38151a6c58c043589aa86a0dbeeea289e0",
			"value": "के हामी डाटाको बारेमा कुरा गरौं?"
		},
		"ctaFinal/text": {
			"hash": "d03b92b93f54bdd2b6acaad1dfec53aac018610e7bcfc914c87162edf401a51f",
			"value": "तρόक परियोजना मलाई सुनाउनुहोस् र प्रदर्शन सुधार गर्ने निर्णयहरू कहाँ छन् भनेर हामी सँगै खोज्छौं।"
		}
	},
	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "मेro बारेमा — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "स्पेनिश म्याडिसन च्याम्पियनबाट डाटा साइन्सका विद्यार्थीसम्म: एलिट साइकलिंग र खेलकुद एनालिटिक्सबीच Mario Álvarez को यात्रा।"
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "मेro बारेमा"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "भेलोड्रोमबाट डाटासम्म"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "मैले प्रतिस्पर्धाबाट सुरु गरेँ। १८ वर्षको उमेरमा म स्पेनिश ट्र्याक म्याडिसन च्याम्पियन बनेँ र स्पेनिश साइक्लिङ राष्ट्रिय टोलीले मलाई विश्व र युरोपेली च्याम्पियनशिपका लागि बोझायो, जहाँ म दुवैमा छैटौं स्थानमा रहें, जसले मलाई एलिट एथलीटको मान्यता दिलायो।"
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "त्यहाँबाट मैले डाटा साइन्समा कदम राखेँ: आज म Universitat Politècnica de València मा डिग्रीको तेस्रो वर्षमा अध्ययन गर्दैछु, जुन खेलकुदमा लागू गरिएको डिजिटलाइजेसन र प्रविधिमा केन्द्रित छ।"
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "मेro भिन्नतामूलक मूल्य भनेको यही पुल हो: मैंने उच्च प्रदर्शनलाई भित्रबाट अनुभव गरेको छु — एक खेलाडीको रूपमा, आधारभूत साइक्लिङ निर्देशकको रूपमा र पेशेवर साइकल चालकहरूको कायरोप्रैक्ट्कको रूपमा — र म पछाडिको डाटा पढ्न जान्दछु। म बुझ्छु कि एउटा अंकको अर्थ खेलाडीका लागि के हुन्छ, किनभने म आफैं त्यो खेलाडी भएको छु। प्रदर्शन सुधार गर्ने निर्णयहरूमा डाटालाई बदल्न म यी दुई संसारलाई जोड्छु।"
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "थप रूपमा, मेro एलिट एथलीटको स्थितिको कारण, मैले खेलकुदमा डिजिटलाइजेसन, इनोभेसन र प्रविधिमा मास्टर गर्न छात्रवृत्ति प्राप्त गरेँ, जुन मैले पूरा गरिसकेको छु र जसले साइकलिंगभन्दा बाहिर सम्पूर्ण खेलकुद इकोसिस्टममा मेro दृष्टिकोणलाई फराकिलो बनाउँछ।"
		},
