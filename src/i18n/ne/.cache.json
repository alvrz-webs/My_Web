	"politica-cookies": {
		"meta/title": {
			"hash": "ff391c80c7c82b6e63ef6862086a634a00d621baebbddac3ab4e12893eee676b",
			"value": "कुकीज नीति — Mario Álvarez"
		},
		"meta/description": {
			"hash": "a4f1a476b3200cd52b729560395661f0add1021d3e2e56acd524b4a0150335c7",
			"value": "यस साइटले कुкіजहरू कसरी प्रयोग गर्छ, कुन उद्देश्यका लागि र कुनै पनि समयमा तपाईंको सहमति कसरी परिवर्तन गर्ने।"
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कानूनी"
		},
		"meta/heading": {
			"hash": "e4124618327d933ffeb091afc88ab0a14227ed69e83aaf285ca403866111d3eb",
			"value": "कुकीज नीति"
		},
		"bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/0/texto": {
			"hash": "df0b70813839255ba6f0aef16202c89953164136f2532b92425c91beee04b8fb",
			"value": "यो वेबसाइटले सही सञ्चालनको लागि र, यदि तपाईंले सहमति दिनुभयो भने, सामग्री कसरी प्रयोग गरिन्छ भनेर अज्ञात रूपमा विश्लेषण गर्न कुкіज र यस्तै प्रविधिहरू (जस्तै ब्राउजरको स्थानीय भण्डारण) प्रयोग गर्छ।"
		},
		"bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/1/texto": {
			"hash": "e940e1ef985d9395730ef5290b220f2331274816823e76bcc7e0be58cc291f87",
			"value": "प्रयोग गरिएका कुкіजहरू:"
		},
		"bloques/2/tipo": {
			"hash": "4a106a9d5ab0bb93b5b43a631db37df385a14c174875bea35bf244e5f35eedc8",
			"value": "tabla"
		},
		"bloques/2/columnas/0": {
			"hash": "562bb15757a8b593d6fdc812b0767c0e198bf7d8e19157933110de09c9db9012",
			"value": "নাম"
		},
		"bloques/2/columnas/1": {
			"hash": "25c2d36c49812b71d0b8d2b43de364c4b8b82606701a7d08e5eade99d9af667c",
			"value": "उद्देश्य"
		},
		"bloques/2/columnas/2": {
			"hash": "3868d2843d5924c192e2f8e32700b6df9b50769ab3dcf5839607c4657a1c4162",
			"value": "प्रकार"
		},
		"bloques/2/columnas/3": {
			"hash": "d5a804455b3392ca88333e92191b96b51f59b644511a73ee3d478fb14d9175d5",
			"value": "अवधि"
		},
		"bloques/2/filas/0/0": {
			"hash": "9b9d58a5d3bd23f1a527509516e0adf5e5be9ed502640fcc0149e8e428d98ca8",
			"value": "consentimiento_cookies"
		},
		"bloques/2/filas/0/1": {
			"hash": "526746432ab0b8216448dc3f4f9aa90177641e413c0f362412c8607a0ad58c60",
			"value": "कुकीज नीति बारे तपाईंको छनौट सम्झिन"
		},
		"bloques/2/filas/0/2": {
			"hash": "e3c9d33af46786951131d096bfd0afca7a45113c203ff264ee3cafb667709165",
			"value": "आफ्नै, प्राविधिक (सहमतिबाट मुक्त)"
		},
		"bloques/2/filas/0/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "१२ महिना"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitante_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "तपाईंको भ्रमणहरू सम्बन्धित गर्न र कुन सामग्री उपयोगी छ भनेर जान्न अज्ञात पहिचानकर्ता"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "आफ्नै, विश्लेषणात्मक (तपाईंको सहमति आवश्यक छ)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "१२ महिना"
		},
		"bloques/3/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "यी मध्ये कुनै पनि कुकी तेस्रो पक्षको होइन, कुनै पनि विज्ञापन उद्देश्यका लागि प्रयोग गरिँदैन, र यस साइट बाहिर कसैैसँग पनि सेयर गरिँदैन।"
		},
		"bloques/4/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "तपाईंले फुटरमा रहेको \"कुकीज कन्फिगर गर्नुहोस्\" लिङ्कबाट कुनै भी समयमा आफ्नो निर्णय परिवर्तन गर्न वा आफ्नो सहमति फिर्ता लिन सक्नुहुन्छ, र सोही प्यानलमा रहेको \"मेरो डेटा मेटाउनुहोस्\" बटनमार्फत तपाईंको सबै डेटा तुरुन्तै मेटाउन सक्नुहुन्छ।"
		},
		"bloques/5/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "तपाईंको डेटा कसरी ह्यान्डल गरिन्छ भन्ने बारे थप जानकारीको लागि, गोपनीयता नीति हेर्नुहोस्।"
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "गोπनीयता नीति — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez को साइटको गोπनीयता नीति: कुन डेटा सङ्कलन गरिन्छ, कुन उद्देश्यका लागि र तपाइँका अधिकारहरू कसरी प्रयोग गर्ने।"
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कानूनी"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "गोपनीयता नीति"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. प्रशोधनको जिम्मेवार व्यक्ति"
		},
		"secciones/0/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, बेनidorm (आलिकान्ते), स्पेनमा ठेगाना भएको। सम्पर्क: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. प्रशोधनको उद्देश्य"
		},
		"secciones/1/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "यो वेबसाइटले आन्तरिक रूपमा र विशेष गरी सांख्यिकीय उद्देश्यका लागि कुन सामग्रीहरू (खण्डहरू, परियोजनाहरू) आगन्तुकहरूका लागि बढी उपयोगी छन् भनेर विश्लेषण गर्दछ, यसको सामग्री सुधार गर्ने उद्देश्यका साथ। यो विज्ञापनको लागि प्रयोग गरिँदैन, तेस्रो पक्षहरूसँग साझेदारी गरिँदैन र कुनै पनि परिस्थितिमा बेच tho गरिँदैन।"
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. सङ्कलन गरिने डेटा (यदि तपाइँ विश्लेषणात्मक कुकीहरू स्वीकार गर्नुहुन्छ भने मात्र)"
		},
		"secciones/2/bloques/0/tipo": {
			"hash": "0296c43c240aa12c0950ff03ab0ebe09a1762b6600266e122f9c4b4099f72359",
			"value": "lista"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "एउटा अनियमित बेनामी पहिचानकर्ता, तपाइँको नाम, इमेल वा तपाइँलाई प्रत्यक्ष रूपमा पहिचान गर्ने अन्य कुनै पनि जानकारीसँग जोडिएको छैन।"
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "तपाइँले भ्रमण गर्नुहुने पृष्ठहरू र परियोजनाहरू, र प्रत्येकमा ध्यान दिइएको समय (ट्याब सक्रिय हुँदा)।"
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "परस्परक्रियाहरू (प्रект, लिङ्क वा बटनहरूमा क्लिकहरू)।"
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "भ्रमणको मिति र समय।"
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "परामर्श गरिएको साइटको भाषा।"
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "यन्त्रको प्रकार (मोबाइल वा डेस्कटप)।"
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "अनुमानित देश, Cloudflare पूर्वाधार मार्फत प्राप्त, तपाइँको IP ठेगाना भण्डारण नगरी।"
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "उत्पत्ति पृष्ठ (उदाहरणका लागि, LinkedIn वा खोज इन्जिन)।"
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "तपाइँको IP ठेगाना सङ्कलन गरिँदैन, ब्राउजर पहिचान प्रविधिहरू (fingerprinting) प्रयोग गरिँदैन, न त Google Analytics वा यस्तै अन्य तेस्रो-पक्ष उपकरणहरू प्रयोग गरिन्छ।"
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. कानूनी आधार"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "प्रशोधन तपाइँको स्पष्ट सहमतिमा आधारित छ (GDPR को धारा 6.1.a र LSSI-CE को धारा 22.2), जसलाई तपाइँ साइटको आफ्नै कुकी प्रबन्धकबाट कुनै पनि समयमा फिर्ता लिन सक्नुहुन्छ।"
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. संरक्षण अवधिको"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "डेटा तपाइँको अन्तिम भ्रमणबाट अधिकतम 12 महिनासम्म राखिन्छ, त्यसपछि तिनीहरू स्वचालित रूपमा मेटाइन्छन्।"
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. प्राप्तकर्ताहरू र अन्तर्राष्ट्रिय स्थानान्तरणहरू"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "डेटा तेस्रो पक्षहरूलाई हस्तान्तरण वा बेच tho गरिँदैन। यो Cloudflare D1 मा भण्डारण गरिएको छ, जो Cloudflare, Inc. द्वारा प्रदान गरिएको डेटाबेस सेवा हो, जसले प्रशोधनकर्ताको रूपमा काम गर्दछ। Cloudflare ले युरोपियन आर्थिक क्षेत्र बाहिर डेटा प्रशोधन गर्न सक्छ; त्यो अवस्थामा, त्यस्तो स्थानान्तरण युरोपेली आयोगद्वारा अनुमोदित मानक संविदात्मक धाराहरूद्वारा संरक्षित हुन्छ। Cloudflare को गोपनीयता नीतिमा थप जानकारी: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. तपाइँका अधिकारहरू"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "तपाइँ malvmar5@hotmail.com मा लेखेर कुनै पनि समयमा पहुँच, सुधार, मेटाउने, विरोध, प्रशोधन सीमित गर्ने र पोर्टेबिलिटीका अधिकारहरू प्रयोग गर्न सक्नुहुन्छ। थप रूपमा, साइटको कुकी कन्फिगरेसनमा उपलब्ध \"मेरो डेटा मेटाउनुहोस्\" बटनबाट कसैलाई लेख्नु नपरिकन, तपाइँ तुरुन्तै आफ्नो डेटा मेटाउन सक्नुहुन्छ। यदि तपाइँ सोच्नुहुन्छ कि तपाइँका अधिकारहरू सही रूपमा सम्बोधन गरिएका छैनन् भने तपाइँ स्पेनिश डेटा संरक्षण एजेन्सी (www.aepd.es) मा उजुरी पेश गर्ने अधिकार पनि राख्नुहुन्छ।"
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. यस नीतिमा परिवर्तनहरू"
		},
		"secciones/7/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "कानूनी वा साइटको आफ्नै परिवर्तनहरू अनुकूल गर्न यो नीति अद्यावधिक गर्न सकिन्छ।"
		}
	}
