		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "Un identificator anonim aleatoriu, care nu este legat de numele dvs., adresa de e-mail sau orice alte informații care vă identifică direct."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "Paginile și proiectele pe care le vizitați și timpul petrecut pe fiecare în parte (cât timp fila este activă)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "Interacțiuni (clicuri pe proiecte, linkuri sau butoane)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "Data și ora vizitei."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "Limba site-ului consultat."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "Tipul de dispozitiv (mobil sau desktop)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "Țara aproximativă, obținută prin infrastructura Cloudflare, fără a stoca adresa IP."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "Pagina de proveniență (de exemplu, LinkedIn sau un motor de căutare)."
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "Adresa dvs. IP nu este colectată, nu sunt utilizate tehnici de identificare a browserului (fingerprinting) și nici instrumente terțe precum Google Analytics sau similare."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. Temeiul juridic"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "Prelucrarea se bazează pe consimțământul dvs. explicit (articolul 6.1.a din RGPD și articolul 22.2 din LSSI-CE), pe care îl puteți retrage în orice moment din managerul de cookie-uri al site-ului în sine."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. Perioada de păstrare"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "Datele sunt păstrate maximum 12 luni de la ultima dvs. vizită, după care sunt șterse automat."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. Destinatari și transferuri internaționale"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "Datele nu sunt cedate sau vândute terților. Ele sunt stocate în Cloudflare D1, un serviciu de baze de date furnizat de Cloudflare, Inc., care acționează în calitate de persoană împuternicită de operator. Cloudflare poate procesa date în afara Spațiului Economic European; în acest caz, un astfel de transfer se bazează the Clauzele Contractuale Standard aprobate de Comisia Europeană. Mai multe informații în politica de confidențialitate Cloudflare: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. Drepturile dumneavoastră"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "Vă puteți exercita oricând drepturile de acces, rectificare, ștergere, opoziție, restricționare a prelucrării și portabilitate scriind la malvmar5@hotmail.com. În plus, vă puteți șterge datele imediat, fără a fi nevoie să scrieți nimănui, de pe butonul „Șterge datele mele” disponibil în setările de cookie-uri ale site-ului. De asemenea, aveți dreptul de a depune o plângere la Agenția Spaniolă pentru Protecția Datelor (www.aepd.es) dacă considerați că drepturile dvs. nu au fost respectate în mod corespunzător."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. Modificări ale acestei politici"
		},
		"secciones/7/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "Această politică poate fi actualizată pentru a se adapta la modificările legislative sau ale site-ului în sine."
		}
	}
}
