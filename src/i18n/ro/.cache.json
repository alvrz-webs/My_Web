		"datos/0/title": {
			"hash": "13cef0dcb61fc73058ec321707889f11b0168613745fa04b982101456aea1628",
			"value": "SIME TELECOM — Stagiu în Știința Datelor"
		},
		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "Ingineria Datelor · Benidorm · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME dezvoltă software de gestiune (rezervări, facturare, rapoarte, comenzi pentru restaurante) care deservește sute de clienți dintr-un sistem central, pe o bază de date cu peste 580 de tabele interconectate și peste 100 de milioane de înregistrări. Creșterea a impus împărțirea clienților pe mai multe baze pentru a reduce sarcina și plângerile legate de lentoare."
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
