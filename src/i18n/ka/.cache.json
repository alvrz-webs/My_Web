			"value": "კონფიდენციალურობის პოლიტიკა"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. მონაცემთა დამმუშავებელი"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, მისამართით: Benidorm (Alicante), ესპანეთი. საკონტაქტო: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. დამუშავების მიზანი"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "ეს ვებსაიტი შიდა დონეზე და ექსკლუზიურად სტატისტიკური მიზნებისთვის აანალიზებს, თუ რომელი შიგთავსი (სექციები, პროექტები) არის ყველაზე სასარგებლო მისი ვიზიტორებისთვის, შიგთავსის გაუმჯობესების მიზნით. ის არ გამოიყენება სარეკლამო მიზნებით, არ ეზიარება მესამე პირებს და არ იყიდება არავითარ შემთხვევაში."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. შეგროვებული მონაცემები (მხოლოდ იმ შემთხვევაში, თუ დაეთანხმებით ანალიტიკურ ქუქი-ფაილებს)"
		},
		"secciones/2/bloques/0/items/0": {
