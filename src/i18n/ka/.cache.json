		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "მონაცემთა ინჟინერია · ბენიდორმი · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME ავითარებს სამართავ პროგრამულ უზრუნველყოფას (ჯავშნები, ფაქტურირება, ანგარიშები, რესტორნის შეკვეთები), რომელიც ემსახურება ასობით კლიენტს ცენტრალური სისტემიდან, +580 ურთიერთდაკავშირებული ცხრილისა და +100 მილიონი ჩანაწერის ბაზაზე. ზრდამ აიძულა კლიენტების განაწილება რამდენიმე ბაზაზე დატვირთვისა და სიზელის შესახებ ჩივილების შესამცირებლად."
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "ჩემი სამუშაო: ამ ბაზების ანალიზი და მოთხოვნებისა და ინდექსების ოპტიმიზაციის გზით, ყველა მონაცემის ერთ ეფექტურ ბაზაში გაერთიანების დაპროექტება აპარატურის (RAM/CPU) თითქმის გაზრდის გარეშე. გაუმჯობესება უკვე შემუშავებულია, სატესტო სერვერზე ვალიდაციის ფაზაშია."
		},
