		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "თქვენი IP მისამართი არ გროვდება, არ გამოიყენება ბრაუზერის იდენტიფიკაციის ტექნიკები (fingerprinting) და მესამე მხარის ინსტრუმენტები, როგორიცაა Google Analytics ან მსგავსი."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. სამართლებრივი საფუძველი"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "დამუშავება ეფუძნება თქვენს მკაფიო თანხმობას (GDPR-ის 6.1.a მუხლი და LSSI-CE-ის 22.2 მუხლი), რომლის გამოხმობაც შეგიძლიათ ნებისმიერ დროს თავად საიტის ქუქი-ფაილების მენეჯერიდან."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. შენახვის ვადა"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "მონაცემები ინახება თქვენი ბოლო ვიზიტიდან მაქსიმუმ 12 თვის განმავლობაში, რის შემდეგაც ავტომატურად იშლება."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. მიმღებები და საერთაშორისო გადაცემები"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "მონაცემები არ გადაეცემა და არ იყიდება მესამე პირებზე. ის ინახება Cloudflare D1-ში, მონაცემთა ბაზის სერვისში, რომელსაც უზრუნველყოფს Cloudflare, Inc., რომელიც მოქმედებს როგორც დამმუშავებელი. Cloudflare-მა შეიძლება დაამუშაოს მონაცემები ევროპის ეკონომიკური ზონის გარეთ; ამ შემთხვევაში, ასეთი გადაცემა დაფუძნებულია ევროკომისიის მიერ დამტკიცებულ სტანდარტულ საკონტრაქტო პუნქტებზე. დამატებითი ინფორმაცია Cloudflare-ის კონფიდენციალურობის პოლიტიკაში: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. თქვენი უფლებები"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "თქვენ შეგიძლიათ ნებისმიერ დროს ისარგებლოთ წვდომის, გასწორების, წაშლის, შეწინააღმდეგების, დამუშავების შეზღუდვისა და პორტირებულობის უფლებებით, თუ მოწერთ მისამართზე malvmar5@hotmail.com. გარდა ამისა, შეგიძლიათ წაშალოთ თქვენი მონაცემები დაუყოვნებლივ, ვინმესთვის მიწერის გარეშე, ღილაკით „ჩემი მონაცემების წაშლა“, რომელიც ხელმისაწვდომია საიტის ქუქი-ფაილების პარამეტრებში. თქვენ ასევე გაქვთ უფლება შეიტანოთ საჩივარი მონაცემთა დაცვის ესპანურ სააგენტოში (www.aepd.es), თუ მიიჩნევთ, რომ თქვენი უფლებები სათანადოდ არ იქნა დაკმაყოფილებული."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. ცვლილებები ამ პოლიტიკაში"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "ეს პოლიტიკა შესაძლებელია განახლდეს კანონმდებლობის ან თავად საიტის ცვლილებების შესაბამისად."
		}
	}
}
