			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "আমি প্রতিযোগিতা করে শুরু করেছিলাম। ১৮ বছর বয়সে আমি ট্র্যাক ম্যারাথনে স্পেনের চ্যাম্পিয়ন হই এবং স্প্যানিশ সাইক্লিং টিম আমাকে বিশ্ব ও ইউরোপীয় চ্যাম্পিয়নশিপে আমন্ত্রণ জানায়, যেখানে আমি দুটিতেই ষষ্ঠ স্থান অধিকার করি, যা আমাকে এলিট ক্রীড়াবিদের মর্যাদা অর্জন করতে সাহায্য করে।"
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "সেখান থেকে আমি ডেটা সায়েন্সে পা রাখি: আজ আমি Universitat Politècnica de València-তে ডিগ্রির ৩য় বর্ষে অধ্যয়ন করছি, যা ক্রীড়ায় প্রয়োগকৃত ডিজিটাইজেশন এবং প্রযুক্তির উপর ফোকাস করে।"
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "আমার মূল পার্থক্য হল সেই সেতু: আমি ভেতর থেকে উচ্চ পারফরম্যান্সের অভিজ্ঞতা অর্জন করেছি — একজন রেসার হিসেবে, একটি বেস সাইক্লিং টিমের স্পোর্টিং ডিরেক্টর হিসেবে এবং পেশাদার সাইক্লিস্টদের কাইরোম্যাসিউর হিসেবে — এবং আমি এর পেছনের ডেটা পড়তে জানি। একজন ক্রীড়াবিদের কাছে একটি সংখ্যার অর্থ কী তা আমি বুঝি, কারণ আমি নিজেই সেই ক্রীড়াবিদ ছিলাম। পারফরম্যান্স উন্নত করে এমন সিদ্ধান্তে ডেটা রূপান্তর করতে আমি এই দুটি জগতকে একত্রিত করি।"
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "এছাড়া, আমার এলিট ক্রীড়াবিদ মর্যাদার সুবাদে, আমি ক্রীড়ায় ডিজিটাইজেশন, ইনোভেশন এবং টেকনোলজিতে একটি মাস্টার্স কোর্স করার জন্য একটি স্কলারশিপ পেয়েছি, যা আমি ইতিমধ্যে সম্পন্ন করেছি এবং যা সাইক্লিংয়ের বাইরে সমগ্র ক্রীড়া ইকোসিস্টেমে আমার দৃষ্টিভঙ্গি প্রসারিত করেছে।"
		},
