		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "এই কুকিগুলোর কোনোটিই তৃতীয় পক্ষের নয়, কোনোটিই বিজ্ঞাপনের উদ্দেশ্যে ব্যবহৃত হয় না এবং এই সাইটের বাইরে কারও সাথে শেয়ার করা হয় না।"
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "আপনি ফুটারের \"কুকিজ কনফিগার করুন\" লিঙ্কের মাধ্যমে যে কোনো সময় আপনার সিদ্ধান্ত পরিবর্তন করতে বা আপনার সম্মতি প্রত্যাহার করতে পারেন এবং একই প্যানেলের \"আমার ডেটা মুছুন\" বোতামের সাহায্যে অবিলম্বে আপনার সমস্ত ডেটা মুছে ফেলতে পারেন।"
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "আপনার ডেটা কীভাবে প্রক্রিয়া করা হয় সে সম্পর্কে আরও তথ্যের জন্য, গোপনীয়তা নীতি দেখুন।"
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "গোপনীয়তা নীতি — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez-এর ওয়েবসাইটের গোপনীয়তা নীতি: কোন ডেটা সংগ্রহ করা হয়, কোন উদ্দেশ্যে এবং কীভাবে আপনার অধিকার প্রয়োগ করবেন।"
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "আইনি"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "গোপনীয়তা নীতি"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "১. ডেটা নিয়ন্ত্রক"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, বেনিদর্ম (আলিকান্তে), স্পেন। যোগাযোগ: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "২. প্রক্রিয়াকরণের উদ্দেশ্য"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "এই ওয়েবসাইটটি তার বিষয়বস্তু উন্নত করার উদ্দেশ্যে অভ্যন্তরীণভাবে এবং একচেটিয়াভাবে পরিসংখ্যানগত উদ্দেশ্যে কোন বিষয়বস্তু (বিভাগ, প্রকল্প) দর্শকদের কাছে সবচেয়ে বেশি উপযোগী তা বিশ্লেষণ করে। এটি বিজ্ঞাপনের উদ্দেশ্যে ব্যবহার করা হয় না, তৃতীয় পক্ষের সাথে শেয়ার করা হয় না এবং কোনো অবস্থাতেই বিক্রি করা হয় না।"
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "৩. সংগৃহীত ডেটা (শুধুমাত্র আপনি বিশ্লেষণাত্মক কুকিজ গ্রহণ করলে)"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "একটি বেনামী র্যান্ডম শনাক্তকারী, আপনার নাম, ইমেল বা আপনাকে সরাসরি সনাক্ত করে এমন অন্য কোনো তথ্যের সাথে লিঙ্ক করা নেই।"
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "যে পৃষ্ঠা এবং প্রকল্পগুলিতে আপনি যান এবং প্রতিটিতে মনোযোগ দেওয়ার সময় (ট্যাবটি সক্রিয় থাকাকালীন)।"
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "ইন্টারঅ্যাকশন (প্রকল্প, লিঙ্ক বা বোতামে ক্লিক)।"
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "দর্শনের তারিখ এবং সময়।"
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "পরামর্শ করা সাইটের ভাষা।"
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "ডিভাইসের ধরন (মোবাইল বা ডেস্কটপ)।"
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "আপনার IP ঠিকানা সংরক্ষণ না করে, Cloudflare পরিকাঠামোর মাধ্যমে প্রাপ্ত আনুমানিক দেশ।"
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "উৎস পৃষ্ঠা (উদাহরণস্বরূপ, LinkedIn বা একটি সার্চ ইঞ্জিন)।"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "আপনার IP ঠিকানা সংগ্রহ করা হয় না, ব্রাউজার সনাক্তকরণ কৌশল (ফিঙ্গারপ্রিন্টিং) ব্যবহার করা হয় না, এবং Google Analytics বা অনুরূপ তৃতীয় পক্ষের টুলও ব্যবহার করা হয় না।"
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "৪. আইনি ভিত্তি"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "প্রক্রিয়াকরণটি আপনার স্পষ্ট সম্মতির উপর ভিত্তি করে (GDPR-এর অনুচ্ছেদ 6.1.a এবং LSSI-CE-এর অনুচ্ছেদ 22.2), যা আপনি সাইটের নিজস্ব কুকি ম্যানেজার থেকে যেকোনো সময় প্রত্যাহার করতে পারেন।"
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "৫. সংরক্ষণের সময়সীমা"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "আপনার শেষ ভিজিট থেকে ডেটা সর্বোচ্চ ১২ মাস ধরে রাখা হয়, যার পরে সেগুলি স্বয়ংক্রিয়ভাবে মুছে ফেলা হয়।"
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "৬. প্রাপক এবং আন্তর্জাতিক স্থানান্তর"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "ডেটা তৃতীয় পক্ষের কাছে হস্তান্তর বা বিক্রি করা হয় না। এগুলি Cloudflare D1-এ সংরক্ষণ করা হয়, যা Cloudflare, Inc. দ্বারা প্রদত্ত একটি ডাটাবেস পরিষেবা, যা প্রসেসর হিসাবে কাজ করে। Cloudflare ইউরোপীয় অর্থনৈতিক অঞ্চলের বাইরে ডেটা প্রক্রিয়া করতে পারে; সেক্ষেত্রে, এই ধরনের স্থানান্তর ইউরোপীয় কমিশন দ্বারা অনুমোদিত স্ট্যান্ডার্ড কন্ট্রাকচুয়াল ক্লাউজ দ্বারা আচ্ছাদিত হয়। Cloudflare-এর গোপনীয়তা নীতিতে আরও তথ্য: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "৭. আপনার অধিকার"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "malvmar5@hotmail.com ঠিকানায় লিখে আপনি যেকোনো সময় অ্যাক্সেস, সংশোধন, মুছে ফেলা, আপত্তি, প্রক্রিয়াকরণের সীমাবদ্ধতা এবং পোর্টেবিলিটির আপনার অধিকার প্রয়োগ করতে পারেন। এছাড়াও, সাইটের কুকি কনফিগারেশনে উপলব্ধ \"আমার ডেটা মুছুন\" বোতাম থেকে কাউকে না লিখেও আপনি অবিলম্বে আপনার ডেটা মুছে ফেলতে পারেন। আপনার অধিকারগুলি সঠিকভাবে সমাধান করা হয়নি বলে মনে করলে স্প্যানিশ ডেটা প্রোটেকশন এজেন্সিতে (www.aepd.es) অভিযোগ দায়ের করার অধিকারও আপনার রয়েছে।"
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "৮. এই নীতিতে পরিবর্তন"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "আইনি পরিবর্তন বা সাইটের সাথে খাপ খাইয়ে নিতে এই নীতি আপডেট করা যেতে পারে।"
		}
	}
}
