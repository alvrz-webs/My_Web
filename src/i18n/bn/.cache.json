		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME এমন ম্যানেজমেন্ট সফটওয়্যার (সংরক্ষণ, বিলিং, রিপোর্ট, রেস্তোরাঁ অর্ডার) তৈরি করে যা একটি সেন্ট্রাল সিস্টেম থেকে শত শত ক্লায়েন্টকে সেবা দেয়, যেখানে +৫৮০টি ইন্টারকানেক্টেড টেবিল এবং +১০০ মিলিয়ন রেকর্ডের একটি ডেটাবেস রয়েছে। বৃদ্ধির কারণে লোড এবং ধীরগতির অভিযোগ কমাতে বেশ কয়েকটি ডেটাবেসে ক্লায়েন্টদের ভাগ করতে বাধ্য হয়েছিল।"
		},
		"datos/0/paragraphs/1": {
			"hash": "a052914694417d03fd48e9c8ff06ccc3b6a57bb6b9d7f5bd67d0540d37b8c3db",
			"value": "আমার কাজ: সেই ডেটাবেসগুলি বিশ্লেষণ করা এবং কোয়ারQUERY অপ্টিমাইজেশান ও ইনডেক্সের মাধ্যমে, হার্ডওয়্যার (RAM/CPU) প্রায় না বাড়িয়েই একটিমাত্র দক্ষ ডেটাবেসে সমস্ত ডেটা একত্রিত করার ডিজাইন করা। উন্নতিটি ইতিমধ্যে তৈরি করা হয়েছে, টেস্ট সার্ভারে যাচাইকরণের পর্যায়ে রয়েছে।"
		},
