	"politica-cookies": {
		"meta/title": {
			"hash": "ff391c80c7c82b6e63ef6862086a634a00d621baebbddac3ab4e12893eee676b",
			"value": "कुकीज धोरण — Mario Álvarez"
		},
		"meta/description": {
			"hash": "a4f1a476b3200cd52b729560395661f0add1021d3e2e56acd524b4a0150335c7",
			"value": "हे साइट कोणत्या कुकीज वापरते, कोणत्या उद्देशाने आणि तुमची सहमती कधीही कशी बदलायची."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कायदेशीर"
		},
		"meta/heading": {
			"hash": "e4124618327d933ffeb091afc88ab0a14227ed69e83aaf285ca403866111d3eb",
			"value": "कुकीज धोरण"
		},
		"bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/0/texto": {
			"hash": "df0b70813839255ba6f0aef16202c89953164136f2532b92425c91beee04b8fb",
			"value": "ही वेबसाइट योग्य कार्यासाठी आणि, जर तुम्ही संमती दिली तर, सामग्रीचा वापर निनावीपणे विश्लेषित करण्यासाठी कुकीज आणि तत्सम तंत्रज्ञान (जसे की ब्राउझर स्थानिक स्टोरेज) वापरते."
		},
		"bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/1/texto": {
			"hash": "e940e1ef985d9395730ef5290b220f2331274816823e76bcc7e0be58cc291f87",
			"value": "वापरलेल्या कुकीज:"
		},
		"bloques/2/tipo": {
			"hash": "4a106a9d5ab0bb93b5b43a631db37df385a14c174875bea35bf244e5f35eedc8",
			"value": "tabla"
		},
		"bloques/2/columnas/0": {
			"hash": "562bb15757a8b593d6fdc812b0767c0e198bf7d8e19157933110de09c9db9012",
			"value": "नाव"
		},
		"bloques/2/columnas/1": {
			"hash": "25c2d36c49812b71d0b8d2b43de364c4b8b82606701a7d08e5eade99d9af667c",
			"value": "उद्देश"
		},
		"bloques/2/columnas/2": {
			"hash": "3868d2843d5924c192e2f8e32700b6df9b50769ab3dcf5839607c4657a1c4162",
			"value": "प्रकार"
		},
		"bloques/2/columnas/3": {
			"hash": "d5a804455b3392ca88333e92191b96b51f59b644511a73ee3d478fb14d9175d5",
			"value": "कालावधी"
		},
		"bloques/2/filas/0/0": {
			"hash": "9b9d58a5d3bd23f1a527509516e0adf5e5be9ed502640fcc0149e8e428d98ca8",
			"value": "consentimiento_cookies"
		},
		"bloques/2/filas/0/1": {
			"hash": "526746432ab0b8216448dc3f4f9aa90177641e413c0f362412c8607a0ad58c60",
			"value": "या कुकीज धोरणाबद्दल तुमची पसंती लक्षात ठेवा"
		},
		"bloques/2/filas/0/2": {
			"hash": "e3c9d33af46786951131d096bfd0afca7a45113c203ff264ee3cafb667709165",
			"value": "स्वतःची, तांत्रिक (संमतीपासून सूट)"
		},
		"bloques/2/filas/0/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 महिने"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitante_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "तुमच्या भेटी जोडण्यासाठी आणि कोणती सामग्री उपयुक्त आहे हे जाणून घेण्यासाठी निनावी ओळखकर्ता"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "स्वतःची, विश्लेषणात्मक (तुमची संमती आवश्यक आहे)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 महिने"
		},
		"bloques/3/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "यापैकी कोणतीही कुकी तृतीय-पक्षाची नाही, कोणतीही जाहिरातीच्या उद्देशाने वापरली जात नाही आणि या साइटबाहेर कोणाशीही सामायिक केली जात नाही."
		},
		"bloques/4/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "तुम्ही पादसंकेतातील (footer) \"कुकीज कॉन्फिगर करा\" (“Configurar cookies”) लिंकवरून कधीही तुमचा निर्णय बदलू शकता किंवा तुमची संमती मागे घेऊ शकता आणि त्याच पॅनलमधील \"माझा डेटा हटवा\" (“Borrar mis datos”) बटणासह तुमचा सर्व डेटा त्वरित हटवू शकता."
		},
		"bloques/5/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "तुमच्या डेटावर कशी प्रक्रिया केली जाते याबद्दल अधिक माहितीसाठी, गोपनीयता धोरण पहा."
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "गोपनीयता धोरण — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez च्या साइटचे गोपनीयता धोरण: कोणտ्या डेटा गोळा केला जातो, कोणत्या उद्देशाने आणि तुमच्या अधिकारांचा वापर कसा करावा."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "कायदेशीर"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "गोपनीयता धोरण"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. डेटा नियंत्रक"
		},
		"secciones/0/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, Benidorm (Alicante), स्पेन येथे स्थित. संपर्क: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. प्रक्रिया करण्याचा उद्देश"
		},
		"secciones/1/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "ही वेबसाइट अंतर्गत आणि केवळ सांख्यिकीय उद्देशांसाठी कोणती सामग्री (विभाग, प्रकल्प) भेट देणाऱ्यांसाठी सर्वात उपयुक्त आहे याचे विश्लेषण करते, ज्याचा उद्देश तिची सामग्री सुधारणे हा आहे. याचा वापर जाहिरातींच्या उद्देशाने केला जात नाही, तो तृतीय पक्षांसोबत सामायिक केला जात नाही आणि कोणत्याही परिस्थितीत विकला जात नाही."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. गोळा केलेला डेटा (फक्त तुम्ही विश्लेषणात्मक कुकीज स्वीकारल्यास)"
		},
		"secciones/2/bloques/0/tipo": {
			"hash": "0296c43c240aa12c0950ff03ab0ebe09a1762b6600266e122f9c4b4099f72359",
			"value": "lista"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "एक यादृच्छिक निनामी ओळखकर्ता, तुमच्या नावाशी, ईमेलशी किंवा तुम्हाला थेट ओळखणाऱ्या इतर कोणत्याही माहितीशी जोडलेला नाही."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "तुम्ही भेट दिलेली पृष्ठे आणि प्रकल्प, आणि प्रत्येकावर लागलेला लक्ष देण्याचा वेळ (टॅब सक्रिय असताना)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "परस्परसंवाद (प्रकल्प, दुवे किंवा बटणांवर क्लिक)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "भेटीची तारीख आणि वेळ."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "पाहिलेली साइटची भाषा."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "डिव्हाइसचा प्रकार (मोबाइल किंवा डेस्कटॉप)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "अंदाजे देश, Cloudflare इन्फ्रास्ट्रक्चरद्वारे प्राप्त केलेला, तुमचा IP पत्ता संचयित न करता."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "मूळ पृष्ठ (उदाहरणार्थ, LinkedIn किंवा शोध इंजिन)."
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "तुमचा IP पत्ता गोळा केला जात नाही, ब्राउझर ओळख तंत्रे (fingerprinting) वापरली जात नाहीत, किंवा Google Analytics किंवा तत्सम तृतीय-पक्षाची साधने वापरली जात नाहीत."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. कायदेशीर पाया"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "प्रक्रिया तुमच्या स्पष्ट संमतीवर आधारित आहे (GDPR चे कलम 6.1.a आणि LSSI-CE चे कलम 22.2), जी तुम्ही साइटच्या स्वतःच्या कुकी व्यवस्थापकावरून कोणत्याही वेळी मागे घेऊ शकता."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. जतन करण्याचा कालावधी"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "डेटा तुमच्या शेवटच्या भेटीपासून जास्तीत जास्त 12 महिने जतन केला जातो, त्यानंतर तो आपोआप हटवला जातो."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. प्राप्तकर्ते आणि आंतरराष्ट्रीय हस्तांतरण"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "डेटा तृतीय पक्षांना हस्तांतरित किंवा विकला जात नाही. तो Cloudflare D1 मध्ये सामायिक केला जातो, जी Cloudflare, Inc. द्वारे प्रदान केलेली डेटाबेस सेवा आहे, जी प्रक्रिया करणारी म्हणून कार्य करते. Cloudflare युरोपियन आर्थिक क्षेत्राच्या बाहेर डेटावर प्रक्रिया करू शकते; त्या बाबतीत, असे हस्तांतरण युरोपियन आयोगाद्वारे मंजूर केलेल्या मानक कंत्राटी कलमांवर आधारित आहे. Cloudflare च्या गोपनीयता धोरणात अधिक माहिती: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. तुमचे अधिकार"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "malvmar5@hotmail.com वर लिहून तुम्ही कधीही प्रवेश, दुरुस्ती, हटवणे, विरोध, प्रक्रिया मर्यादित करणे आणि सुलभतेचे अधिकार वापरू शकता. याव्यतिरिक्त, साइटच्या कुकी कॉन्फिगरेशनमध्ये उपलब्ध असलेल्या \"माझा डेटा हटवा\" बटणावरून कोणालाही न लिहिता तुम्ही तुमचा डेटा त्वरित हटवू शकता. तुमचे अधिकार योग्य प्रकारे हाताळले गेले नाहीत असे तुम्हाला वाटल्यास, स्पॅनिश डेटा प्रोटेक्शन एजन्सीकडे (www.aepd.es) तक्रार दाखल करण्याचा अधिकार तुम्हाला आहे."
		},
