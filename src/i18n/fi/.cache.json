		"datos/0/meta": {
			"hash": "87ebafa84cbcbff26ec4f3a92e21005f295389782d7c36ca4ad1ac8def78386b",
			"value": "Data-insinööritiede · Benidorm · 2026"
		},
		"datos/0/paragraphs/0": {
			"hash": "57f164dfc01f0d482069a82ca0f94414be995d79c1c1c0726f23a36349e6450d",
			"value": "SIME kehittää hallintaohjelmistoja (varaukset, laskutus, raportit, ravintolatilaukset), jotka palvelevat satoja asiakkaita keskusjärjestelmästä, yli 580 toisiinsa kytketyn taulun ja yli 100 miljoonan tietueen tietokannassa. Kasvu oli pakottanut jakamaan asiakkaita useisiin tietokantoihin kuormituksen ja hitausvalitusten lieventämiseksi."
		},
		"datos/0/paragraphs/1": {
