		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "Tämä verkkosivusto analysoi sisäisesti ja yksinomaan tilastollisia tarkoituksia varten, mitkä sisällöt (osiot, projektit) ovat vierailijoille hyödyllisimpiä, tavoitteenaan sisällön parantaminen. Sitä ei käytetä mainontatarkoituksiin, sitä ei jaeta kolmansille osapuille eikä sitä myydä missään olosuhteissa."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. Kerättävät tiedot (vain jos hyväksyt analyyttiset evästeet)"
		},
		"secciones/2/bloques/0/tipo": {
			"hash": "0296c43c240aa12c0950ff03ab0ebe09a1762b6600266e122f9c4b4099f72359",
			"value": "lista"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "Satunnainen anonymisoitu tunniste, jota ei ole sidottu nimeesi, sähköpostiisi tai muihin suoraan sinut tunnistaviin tietoihin."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "Sivut ja projektit, joilla vierailet, sekä kussakin vietetty aika (kun välilehti on aktiivinen)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "Vuorovaikutukset (klikkaukset projekteissa, linkeissä tai painikkeissa)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "Vierailun päivämäärä ja kellonaika."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "Katsotun sivuston kieli."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "Laitetyyppi (mobiili tai työpöytä)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "Arvioitu maa, joka saadaan Cloudflaren infrastruktuurin kautta tallentamatta IP-osoitettasi."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "Saapumissivu (esimerkiksi LinkedIn tai hakukone)."
		},
		"secciones/2/bloques/1/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "IP-osoitettasi ei kerätä, selaimen tunnistustekniikoita (fingerprinting) ei käytetä, eikä kolmannen osapuolen työkaluja, kuten Google Analyticsia tai vastaavia, käytetä."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. Oikeusperusta"
		},
		"secciones/3/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "Käsittely perustuu nimenomaiseen suostumukseesi (GDPR:n artikla 6.1.a ja Espanjan LSSI-CE:n artikla 22.2), jonka voit peruuttaa milloin tahansa sivuston omasta evästeiden hallinnasta."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. Säilytysaika"
		},
		"secciones/4/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "Tietoja säilytetään enintään 12 kuukautta viimeisestä vierailustasi, minkä jälkeen ne poistetaan automaattisesti."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. Vastaanottajat ja kansainväliset siirrot"
		},
		"secciones/5/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "Tietoja ei luovuteta eikä myydä kolmansille osapuille. Ne tallennetaan Cloudflare D1:een, Cloudflare, Inc:n tarjoamaan tietokantapalveluun, joka toimii henkilötietojen käsittelijänä. Cloudflare voi käsitellä tietoja Euroopan talousalueen ulkopuolella; tässä tapauksessa siirto perustuu Euroopan komission hyväksymiin EU:n mallisopimuslausekkeisiin. Lisätietoja Cloudflaren tietosuojakäytännöstä: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. Sinun oikeutesi"
		},
		"secciones/6/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "Voit käyttää milloin tahansa oikeuttasi tutustua tietoihin, oikaista niitä, poistaa niitä, vastustaa niiden käsittelyä, rajoittaa sitä ja siirtää tiedot toiselle järjestelmälle kirjoittamalla osoitteeseen malvmar5@hotmail.com. Lisäksi voit poistaa tietosi välittömästi ilman tarvetta kirjoittaa kenellekään sivuston evästeasetuksista löytyvän \"Poista tietoni\" -painikkeen kautta. Sinulla on myös oikeus tehdä valitus Espanjan tietosuojaviranomaiselle (www.aepd.es), jos katsot, että oikeuksiasi ei ole käsitelty asianmukaisesti."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. Muutokset tähän käytäntöön"
		},
		"secciones/7/bloques/0/tipo": {
			"hash": "b0df580829160d10430a6e957ad6c5d8412c4eff1bf6caccce28c02b17ec6e84",
			"value": "parrafo"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "Tätä käytäntöä voidaan päivittää vastaamaan lainsäädännön tai itse sivuston muutoksia."
		}
	}
}
