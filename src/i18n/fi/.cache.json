	"sobre-mi": {
		"meta/title": {
			"hash": "4c3d3ad7a59738a85621c902a9c559c3f17d126604eb1170d4d5a496eca743e6",
			"value": "Minusta — Mario Álvarez"
		},
		"meta/description": {
			"hash": "065998767d0c9a6c0b30b681912801e42c75ce724eaaf80c998f070b9439f0cd",
			"value": "Espanjan madisonin mestarista datatieteiden opiskelijaksi: Mario Álvarezin polku huippupyöräilyn ja urheiluanalytiikan välillä."
		},
		"meta/eyebrow": {
			"hash": "ee6d6aedc0ae76956d66653aa3ad9804006ac76f9372582942a0e3f47279bbd8",
			"value": "Minusta"
		},
		"meta/heading": {
			"hash": "9fd41fd70d777da84f59b0515b4880212df8574caec879bd9545a461d5052fc7",
			"value": "Velodromilta datoihin"
		},
		"bio/0": {
			"hash": "d7d611e5e1b9b9834eb8052dd8edd5c1e1986ee032a232146858b8bcedcbb7b0",
			"value": "Aloitin kilpailemisen. 18-vuotiaana minut kruunattiin Espanjan mestariksi ratamaisonissa, ja Espanjan pyöräilymaajoukkue kutsui minut maailman- ja Euroopan-mestaruuskilpailuihin, joissa olin kuudes. Tämä antoi minulle huippu-urheilijan aseman."
		},
		"bio/1": {
			"hash": "cb7a91dc70b36b438e730343472b3d3ece358d6f4aa95b52f66421a63990951f",
			"value": "Sieltä siirryin datatieteisiin: tällä hetkellä opiskelen kolmatta vuotta datatieteiden kandidaatiksi Universitat Politècnica de Valènnialla, ja opintoni keskittyvät urheiluun sovellettuun digitalisaatioon ja teknologiaan."
		},
		"bio/2": {
			"hash": "6eeee944c5047dd44420998562b90a8ea28d2c35be7a2e1e836348e8d509d121",
			"value": "Erottuva tekijäni on tämä silta: olen kokenut korkean suorituskyvyn sisältäpäin – kilpailijana, nuorten urheilijoiden urheiluohjaajana ja ammattipyöräilijöiden urheiluhierojana – ja osaan lukea datan sen takana. Ymmärrän, mitä luku merkitsee urheilijalle, sillä olen itse ollut se urheilija. Yhdistän nämä kaksi maailmaa muuttaakseni datan suorituskykyä parantaviksi päätöksiksi."
		},
		"bio/3": {
			"hash": "453e09fc193caca7117df201b7a7d0d40cc56a10520b2de9a62cae6643ada803",
			"value": "Lisäksi huippu-urheilijan asemastani johtuen sain stipendin urheilun digitalisaation, innovaatioiden ja teknologian maisteriohjelmaan, jonka olen jo suorittanut ja joka laajentaa näkökulmani koko urheiluekosysteemiin pyöräilyn ulkopuolelle."
		},
