			"hash": "ff391c80c7c82b6e63ef6862086a634a00d621baebbddac3ab4e12893eee676b",
			"value": "Sīkdatņu politika — Mario Álvarez"
		},
		"meta/description": {
			"hash": "a4f1a476b3200cd52b729560395661f0add1021d3e2e56acd524b4a0150335c7",
			"value": "Kādas sīkdatnes šī vietne izmanto, kādam nolūkam un kā jebkurā laikā mainīt savu piekrišanu."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "Juridiskā informācija"
		},
		"meta/heading": {
			"hash": "e4124618327d933ffeb091afc88ab0a14227ed69e83aaf285ca403866111d3eb",
			"value": "Sīkdatņu politika"
		},
		"bloques/0/texto": {
			"hash": "df0b70813839255ba6f0aef16202c89953164136f2532b92425c91beee04b8fb",
			"value": "Šī vietne izmanto sīkdatnes un līdzīgas tehnoloģijas (piemēram, pārlūkprogrammas vietējo krātuvi), lai nodrošinātu tās pareizu darbību un, ja jūs sniedzat savu piekrišanu, lai anonīmi analizētu, kā tiek izmantots saturs."
		},
		"bloques/1/texto": {
			"hash": "e940e1ef985d9395730ef5290b220f2331274816823e76bcc7e0be58cc291f87",
			"value": "Izmantotās sīkdatnes:"
		},
		"bloques/2/columnas/0": {
			"hash": "562bb15757a8b593d6fdc812b0767c0e198bf7d8e19157933110de09c9db9012",
			"value": "Nosaukums"
		},
		"bloques/2/columnas/1": {
			"hash": "25c2d36c49812b71d0b8d2b43de364c4b8b82606701a7d08e5eade99d9af667c",
			"value": "Nolūks"
		},
		"bloques/2/columnas/2": {
			"hash": "3868d2843d5924c192e2f8e32700b6df9b50769ab3dcf5839607c4657a1c4162",
			"value": "Veids"
		},
		"bloques/2/columnas/3": {
			"hash": "d5a804455b3392ca88333e92191b96b51f59b644511a73ee3d478fb14d9175d5",
			"value": "Ilgums"
		},
		"bloques/2/filas/0/0": {
			"hash": "9b9d58a5d3bd23f1a527509516e0adf5e5be9ed502640fcc0149e8e428d98ca8",
			"value": "consentimiento_cookies"
		},
		"bloques/2/filas/0/1": {
			"hash": "526746432ab0b8216448dc3f4f9aa90177641e413c0f362412c8607a0ad58c60",
			"value": "Atcerēties jūsu izvēli par šo sīkdatņu politiku"
		},
		"bloques/2/filas/0/2": {
			"hash": "e3c9d33af46786951131d096bfd0afca7a45113c203ff264ee3cafb667709165",
			"value": "Paša, tehniska (atbrīvota no piekrišanas)"
		},
		"bloques/2/filas/0/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 mēneši"
		},
		"bloques/2/filas/1/0": {
			"hash": "e0f202a1c6e8a418ed21ee100ff75aa5d5359a103cf68a933e4ff65da01e73fd",
			"value": "visitante_id"
		},
		"bloques/2/filas/1/1": {
			"hash": "b3919a32c22f00fb5e847e80e59edbd9870c5dd4105ff2ccf863e601ab0b7832",
			"value": "Anonīms identifikators, lai saistītu jūsu apmeklējumus un noskaidrotu, kurš saturs ir noderīgs"
		},
		"bloques/2/filas/1/2": {
			"hash": "64d8b5b55e8b71350902309574cc2873bad88a946e8ded53d21e858419cd92be",
			"value": "Paša, analītiska (nepieciešama jūsu piekrišana)"
		},
		"bloques/2/filas/1/3": {
			"hash": "1672d102f0209f0e0ffcbffbec218b4290f317de6c83a64c8f5dc17741f7284c",
			"value": "12 mēneši"
		},
		"bloques/3/texto": {
			"hash": "6f4f63a9b064b4de6d9c8a394445f2b9fb957a6a3d11454d9b2f7234424cd45b",
			"value": "Neviena no šīm sīkdatnēm nav trešo pušu, neviena netiek izmantota reklāmas nolūkos, un neviena netiek kopīgota ar kādu ārpus šīs vietnes."
		},
		"bloques/4/texto": {
			"hash": "73006d4d6e97a1c4c05012796e37d3aa19c01ffe4b9499ffcc6e0dbd7d1aedde",
			"value": "Jūs varat mainīt savu lēmumu vai atsaukt piekrišanu jebkurā laikā no saites \"Konfigurēt sīkdatnes\" lapas apakšdaļā un nekavējoties dzēst visus savus datus ar pogu \"Dzēst manus datus\" šajā pašā panelī."
		},
		"bloques/5/texto": {
			"hash": "933290e837562b81d3a381c76d73848c4470a0806e8e74fb8bd21c5686dc9011",
			"value": "Papildinformāciju par to, kā tiek apstrādāti jūsu dati, skatiet Privātuma politikā."
		}
	},
	"politica-privacidad": {
		"meta/title": {
			"hash": "5eb1ffaae207ebfdc01206669160a7eb13bbda5f7d0df07c91a61347d04201cd",
			"value": "Privātuma politika — Mario Álvarez"
		},
		"meta/description": {
			"hash": "55cbde0a4c616c7963ed80ea74d1d2e49ba6d9244098464d2b01a18a94622b4f",
			"value": "Mario Álvarez vietnes privātuma politika: kādi dati tiek vākti, kādam nolūkam un kā īstenot savas tiesības."
		},
		"meta/eyebrow": {
			"hash": "4787eaf7c938045fd5285fe6a2cd72558caf7bd5faeb93fd1ad490a502e0e37b",
			"value": "Juridiskā informācija"
		},
		"meta/heading": {
			"hash": "fa322aa36e894213aed9f8a79fec4ddd0216728531ff91865fe6b4dd64414b19",
			"value": "Privātuma politika"
		},
		"secciones/0/titulo": {
			"hash": "f40a08d55695b46cb06936305609a659cf2264635ce95082b10adbe117704945",
			"value": "1. Pārzinis"
		},
		"secciones/0/bloques/0/texto": {
			"hash": "ac3102e120f1de213123ba2c257915460c24e3b41b2afe2253f02c5c2def52a9",
			"value": "Mario Álvarez Martínez, ar adresi Benidorm (Alikante), Spānija. Kontakti: malvmar5@hotmail.com"
		},
		"secciones/1/titulo": {
			"hash": "369b07a4ec05109e35b70619a64c071e530c120ee701be931eaabc05f5483c11",
			"value": "2. Apstrādes nolūks"
		},
		"secciones/1/bloques/0/texto": {
			"hash": "afc2570cb8faf47c545fce55f68ac37408c3e2848f90499ec793ee2a506d474d",
			"value": "Šī vietne iekšēji un ekskluzīvi statistikas nolūkos analizē, kurš saturs (sadaļas, projekti) apmeklētājiem šķiet visnoderīgākais, lai uzlabotu tās saturu. Tā netiek izmantota reklāmas nolūkos, netiek kopīgota ar trešajām pusēm un nekādos apstākļos netiek pārdota."
		},
		"secciones/2/titulo": {
			"hash": "14f786ea9ef7e0ab79b9c1c839d43d8f00f1a3dad7b3e4d585e1ca16bac30de3",
			"value": "3. Apkopotie dati (tikai tad, ja piekrītat analītiskajām sīkdatnēm)"
		},
		"secciones/2/bloques/0/items/0": {
			"hash": "af9dbef21552a998898a6e6b87ce3ab608a25ee145ba00d9b39c7e0e058c7b94",
			"value": "Nejauša anonīma identifikatora numurs, kas nav saistīts ar jūsu vārdu, e-pastu vai citu informāciju, kas jūs tieši identificē."
		},
		"secciones/2/bloques/0/items/1": {
			"hash": "c78cee22ee30d940fc9510cb8a9a54dc35331852e95b33c7c167defe4100563b",
			"value": "Apmeklētās lapas un projekti, kā arī katrā no tiem pavadītais laiks (kamēr cilne ir aktīva)."
		},
		"secciones/2/bloques/0/items/2": {
			"hash": "58eb754e814f1b0cd7a755bae6f582d6b70812a4770dbae0ed91588a4c9ffafe",
			"value": "Mijiedarbība (klikšķi uz projektiem, saitēm vai pogām)."
		},
		"secciones/2/bloques/0/items/3": {
			"hash": "7c88de12fdd883efe563e638c70bce66b6fb9fd4fc27e31d2a7ca6fc72a47b63",
			"value": "Apmeklējuma datums un laiks."
		},
		"secciones/2/bloques/0/items/4": {
			"hash": "e54a7cdd886ad5055264d01aea081fb51d909d54d0024e9e4a01e43bccbe5ead",
			"value": "Konsultētās vietnes valoda."
		},
		"secciones/2/bloques/0/items/5": {
			"hash": "5709d70ab8af14465ad963432975debae9d95d4ad23a47eeac819cc60819fed0",
			"value": "Ierīces tips (mobilā vai galddatora)."
		},
		"secciones/2/bloques/0/items/6": {
			"hash": "0c368fa7c18141ac18d5d56f78801fced4707f4052cc2b808ce9c625116c1b29",
			"value": "Aptuvenā valsts, kas iegūta, izmantojot Cloudflare infrastruktūru, neuzglabājot jūsu IP adresi."
		},
		"secciones/2/bloques/0/items/7": {
			"hash": "1f3aa8c499ab923ba2a459524c44358dd24b8e18592d64472b44710437af9c62",
			"value": "Izcelsmes lapa (piemēram, LinkedIn vai meklētājprogramma)."
		},
		"secciones/2/bloques/1/texto": {
			"hash": "d175666aba57f0dfb2dc69cd692375e4e02f6ddf9ff9c9e2d0257bf0cb352703",
			"value": "Jūsu IP adrese netiek vākta, netiek izmantotas pārlūkprogrammas identifikācijas tehnikas (fingerprinting) vai trešo pušu rīki, piemēram, Google Analytics vai tamlīdzīgi."
		},
		"secciones/3/titulo": {
			"hash": "33c48d6078a48147685e7677503e27d7f86fe5eae823d85ac870cdb7c94fa8d5",
			"value": "4. Likumīgais pamats"
		},
		"secciones/3/bloques/0/texto": {
			"hash": "f1ae41312216be39906db5c7cb7d0a005bab509b6b7cb783065384072dfb8964",
			"value": "Apstrāde balstās uz jūsu nepārprotamu piekrišanu (VPDAR 6. panta 1. punkta a apakšpunkts un LSSI-CE 22. panta 2. punkts), kuru varat jebkurā laikā atsaukt no pašas vietnes sīkdatņu pārvaldnieka."
		},
		"secciones/4/titulo": {
			"hash": "a41ded5492687d08a215c7490d62f74228987bb06111c2ba69490ea3025be80d",
			"value": "5. Saglabāšanas termiņš"
		},
		"secciones/4/bloques/0/texto": {
			"hash": "7bb8833d1eab1765f9c083deceec4044357b6de859de2e32fc39a41a113862eb",
			"value": "Dati tiek glabāti ne ilgāk kā 12 mēnešus kopš jūsu pēdējā apmeklējuma, pēc kura tie tiek automātiski dzēsti."
		},
		"secciones/5/titulo": {
			"hash": "7c2b75743b9e94adb5f4706fa030121ec1fa06a82e145afc84b7a30d60de7694",
			"value": "6. Saņēmēji un starptautiskā datu pārsūtīšana"
		},
		"secciones/5/bloques/0/texto": {
			"hash": "9ce7964082f3b503954b8d19202472e7adccae03b47c270bee9150745637c8ce",
			"value": "Dati netiek izpausti vai pārdoti trešajām pusēm. Tie tiek glabāti Cloudflare D1, datu bāzes pakalpojumā, ko nodrošina Cloudflare, Inc., kas darbojas kā apstrādātājs. Cloudflare var apstrādāt datus ārpus Eiropas Ekonomikas zonas; šādā gadījumā šāda pārsūtīšana balstās uz Eiropas Komisijas apstiprinātajiem Līguma standartklauzulu noteikumiem. Vairāk informācijas Cloudflare privātuma politikā: https://www.cloudflare.com/privacypolicy/"
		},
		"secciones/6/titulo": {
			"hash": "3d62da5234ceaa31566dbcfaae30ea5b42ca2e0e47744e6eb4ed49d6b5de736f",
			"value": "7. Jūsu tiesības"
		},
		"secciones/6/bloques/0/texto": {
			"hash": "601306cdeb3e9eb384a4a1271889c8f722ab000f6d52027acab166e0ecd50959",
			"value": "Jūs varat jebkurā laikā īstenot savas tiesības piekļūt, labot, dzēst, iebilst, ierobežot apstrādi un datu pārnesamību, rakstot uz malvmar5@hotmail.com. Turklāt jūs varat nekavējoties izdzēst savus datus, nevienam nerakstot, izmantojot pogu \"Dzēst manus datus\", kas pieejama vietnes sīkdatņu iestatījumos. Jums ir arī tiesības iesniegt sūdzību Spānijas Datu aizsardzības aģentūrā (www.aepd.es), ja uzskatāt, ka jūsu tiesības nav ievērotas pareizi."
		},
		"secciones/7/titulo": {
			"hash": "4421ef735f17920d95672a4ae66c564ac1730cd7e91a8394647ea2a49c49c8a3",
			"value": "8. Izmaiņas šajā politikā"
		},
		"secciones/7/bloques/0/texto": {
			"hash": "2a4ab076dd286654e51a114fc7dcc2b7f6837cf459753f8292aa56008ea7877e",
			"value": "Šī politika var tikt atjaunināta, lai pielāgotos likumdošanas vai pašas vietnes izmaiņām."
		}
	}
}
