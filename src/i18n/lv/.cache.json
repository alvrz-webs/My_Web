		"experienciaResumen/title": {
			"hash": "077eeafeaba85ca233eb8c419d41076238aca8fc18a3d2d035b791607bcccc1a",
			"value": "Divas pasaules, viena valoda: sniegums"
		},
		"experienciaResumen/text": {
			"hash": "fab92a26eae655346db1662eb8971457d54d58c22526368ec25b46ab46f46fee",
			"value": "Esmu sacenties augstākajā līmenī un šodien piemēroju to pašu kritēriju datiem: es saprotu, ko skaitlis nozīmē sportistam, jo esmu bijis šis sportists."
