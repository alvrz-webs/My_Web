---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import PoliticaBloques from '../PoliticaBloques.astro';
import { type Locale } from '../../lib/i18n';
import { getDict } from '../../lib/dictionary';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const politica = getDict(lang, 'politica-privacidad') as any;
const t = politica.meta;
---

<Layout title={t.title} description={t.description} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.heading} />

	<section class="politica">
		<div class="container politica-inner">
			{
				politica.secciones.map((seccion) => (
					<article class="politica-seccion">
						<h2>{seccion.titulo}</h2>
						<PoliticaBloques bloques={seccion.bloques} />
					</article>
				))
			}
		</div>
	</section>
</Layout>

<style>
	.politica {
		padding-block: 1rem 6rem;
	}

	.politica-inner {
		max-width: 74ch;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.politica-seccion h2 {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 600;
		margin-block-end: 0.85rem;
		padding-block-end: 0.6rem;
		border-bottom: 1px solid var(--color-border);
	}
</style>
