---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import CierreContacto from '../CierreContacto.astro';
import EscenaPuntos from '../EscenaPuntos.astro';
import { localizedPath, type Locale } from '../../lib/i18n';
import { getDict } from '../../lib/dictionary';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const sobreMi = getDict(lang, 'sobre-mi') as any;
const { bio, facts, meta: t } = sobreMi;
const cierre = (getDict(lang, 'common') as any).cierre;
---

<Layout title={t.title} description={t.description} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.heading} description={t.lead} asideArriba>
		<div slot="aside" class="retrato" data-parallax="16">
			<div class="retrato-marco">
				<img src="/mario.webp" alt={t.retratoAlt ?? 'Mario Álvarez'} width="640" height="800" fetchpriority="high" decoding="async" />
			</div>
		</div>
	</PageHeader>

	<EscenaPuntos frase={t.escenaFrase} id="de-cerca" />

	<section class="seccion historia campo-invertido" data-tracking-seccion="sobre-mi">
		<div class="container rejilla-rotulo">
			<div class="rotulo-fijo">
				<h2 class="titulo-seccion" data-entra>{t.historiaTitulo}</h2>
			</div>

			<div class="bio">
				{
					bio.map((parrafo: string, i: number) => (
						<p class:list={{ 'bio-entrada': i === 0 }} data-entra>
							{parrafo}
						</p>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion ficha-seccion">
		<div class="container rejilla-rotulo">
			<div class="rotulo-fijo">
				<h2 class="titulo-seccion" data-entra>{t.fichaTitulo}</h2>
				<p class="lead ficha-intro" data-entra style="--i:1">{t.fichaTexto}</p>
			</div>

			<dl class="ficha">
				{
					facts.map((fact: any, i: number) => (
						<div class="ficha-fila" data-entra style={`--i:${i}`}>
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<CierreContacto titulo={cierre.title} texto={cierre.text} cta={cierre.cta} href={localizedPath('/contacto', lang)} />
</Layout>

<style>
	/* Mismo óvalo que el retrato de inicio: al navegar entre las dos páginas, uno se convierte en el otro */
	.retrato {
		position: relative;
		inline-size: min(100%, 330px);
		padding: 18px;
	}

	.retrato::before,
	.retrato::after {
		content: '';
		position: absolute;
		border-radius: 999px;
		pointer-events: none;
	}

	/* Banda côte d'azur y línea sprinter alrededor, como en la pista */
	.retrato::before {
		inset: 6px;
		border: 7px solid var(--linea-azur);
		opacity: 0.85;
	}

	.retrato::after {
		inset: -4px;
		border: 3px solid var(--linea-sprinter);
	}

	.retrato-marco {
		aspect-ratio: 258 / 358;
		border-radius: 999px;
		overflow: clip;
		background: var(--color-bg-elevated);
		view-transition-name: retrato;
	}

	.retrato-marco img {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	/* ---------- Historia (el punto que se abre en la escena ya es de este color) ---------- */
	.historia {
		padding-block-start: var(--space-tras-cabecera);
	}

	.bio {
		display: grid;
		gap: 1.4rem;
		max-width: 62ch;
	}

	.bio p {
		font-size: 1.12rem;
		line-height: 1.7;
	}

	.bio .bio-entrada {
		font-size: var(--fs-lead);
		line-height: 1.55;
	}

	/* ---------- Ficha ---------- */
	.ficha-intro {
		margin-block-start: 1.5rem;
	}

	.ficha {
		border-block-start: 3px solid var(--color-text);
	}

	.ficha-fila {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 1.25rem;
		align-items: baseline;
		padding-block: 1.25rem;
		border-block-end: 1px solid var(--color-border);
	}

	.ficha dt {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--color-text-dim);
	}

	.ficha dd {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		line-height: 1.2;
	}

	@media (max-width: 860px) {
		.retrato {
			inline-size: min(56vw, 240px);
			padding: 14px;
		}
	}

	@media (max-width: 480px) {
		.ficha-fila {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
	}
</style>
