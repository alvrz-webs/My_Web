---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import CierreContacto from '../CierreContacto.astro';
import { localizedPath, type Locale } from '../../lib/i18n';
import { getDict } from '../../lib/dictionary';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const experiencia = getDict(lang, 'experiencia') as any;
const { datos: datosItems, deporte: deporteItems, meta: t } = experiencia;
const cierre = (getDict(lang, 'common') as any).cierre;

// Dos tramos, cada uno con su carril: datos por la stayer, deporte por la sprinter.
const tramos = [
	{ id: 'datos', titulo: t.colDatos, items: datosItems, clase: 'tramo-datos' },
	{ id: 'deporte', titulo: t.colDeporte, items: deporteItems, clase: 'tramo-deporte campo-invertido' },
];
---

<Layout title={t.title} description={t.description} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.heading} description={t.lead}>
		{
			t.cifras?.length > 0 && (
				<ul slot="aside" class="cifras">
					{t.cifras.map((c: any) => (
						<li class="cifra">
							<span class="cifra-valor">{c.cifra}</span>
							<span class="cifra-texto">{c.texto}</span>
						</li>
					))}
				</ul>
			)
		}
	</PageHeader>

	{
		tramos.map((tramo, n) => (
			<section id={tramo.id} class:list={['seccion', 'tramo', tramo.clase]} data-tracking-seccion={n === 0 ? 'experiencia' : undefined}>
				<div class="container">
					<h2 class="titulo-seccion tramo-titulo" data-entra>
						{tramo.titulo}
					</h2>

					<ul class="entradas">
						{tramo.items.map((item: any) => (
							<li class="entrada" data-entra>
								<p class="entrada-meta">{item.meta}</p>
								<div class="entrada-cuerpo">
									<h3>{item.title}</h3>
									{item.paragraphs?.map((p: string) => (
										<p>{p}</p>
									))}
									{item.list && (
										<ul class="entrada-lista">
											{item.list.map((entry: string) => (
												<li>{entry}</li>
											))}
										</ul>
									)}
									{item.link && (
										<a href={localizedPath(item.link.href, lang)} class="link-arrow">
											{item.link.label}
										</a>
									)}
								</div>
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}

	<CierreContacto titulo={cierre.title} texto={cierre.text} cta={cierre.cta} href={localizedPath('/contacto', lang)} />
</Layout>

<style>
	/* ---------- Cifras de cabecera ---------- */
	.cifras {
		list-style: none;
		display: grid;
		gap: 0;
		inline-size: 100%;
		max-inline-size: 380px;
		border-block-start: 3px solid var(--color-text);
	}

	.cifra {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding-block: 1rem;
		border-block-end: 1px solid var(--color-border);
	}

	.cifra-valor {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 2.1rem;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.cifra-texto {
		font-size: 1rem;
		line-height: 1.45;
	}

	/* ---------- Tramos ---------- */
	.tramo-datos {
		--carril: var(--linea-stayer);
		padding-block-start: var(--space-tras-cabecera);
	}

	.tramo-deporte {
		--carril: var(--linea-sprinter);
	}

	.tramo-titulo::before {
		background: var(--carril);
	}

	.entradas {
		list-style: none;
		display: grid;
		gap: clamp(2.75rem, 5vw, 4rem);
		margin-block-start: var(--space-block);
	}

	/* Cada experiencia: la fecha y el lugar a un lado, el trabajo al otro, sobre la línea de su carril */
	.entrada {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
		gap: 1.25rem var(--gutter);
		padding-block-start: 1.5rem;
		border-block-start: 4px solid var(--carril);
	}

	.entrada-meta {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--color-text-dim);
	}

	.entrada-cuerpo {
		display: grid;
		gap: 1rem;
		max-width: 64ch;
	}

	.entrada-cuerpo h3 {
		font-size: var(--fs-h3);
		font-weight: 700;
		line-height: 1.1;
	}

	.entrada-cuerpo p {
		font-size: 1.08rem;
		line-height: 1.65;
	}

	.entrada-lista {
		list-style: none;
		display: grid;
		gap: 0.85rem;
	}

	.entrada-lista li {
		position: relative;
		padding-inline-start: 1.4rem;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	/* Viñeta: un tramo corto del carril */
	.entrada-lista li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.72em;
		inline-size: 0.8rem;
		block-size: 3px;
		background: var(--carril);
	}

	.entrada-cuerpo .link-arrow {
		justify-self: start;
	}

	@media (max-width: 760px) {
		.entrada {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.6rem;
		}
	}
</style>
