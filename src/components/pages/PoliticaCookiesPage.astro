---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import PoliticaBloques from '../PoliticaBloques.astro';
import { type Locale } from '../../lib/i18n';
import { getDict } from '../../lib/dictionary';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const politica = getDict(lang, 'politica-cookies') as any;
const t = politica.meta;
---

<Layout title={t.title} description={t.description} lang={lang}>
	<PageHeader eyebrow={t.eyebrow} title={t.heading} />

	<section class="politica">
		<div class="container politica-inner">
			<PoliticaBloques bloques={politica.bloques} />
		</div>
	</section>
</Layout>

<style>
	.politica {
		padding-block: 1rem 6rem;
	}

	.politica-inner {
		max-width: 74ch;
	}
</style>
