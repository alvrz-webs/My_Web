---
import PaginaLegal from '../PaginaLegal.astro';
import { type Locale } from '../../lib/i18n';
import { getDict } from '../../lib/dictionary';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const t = (getDict(lang, 'politica-cookies') as any).meta;
const cookies = (getDict(lang, 'common') as any).cookies;
---

<PaginaLegal lang={lang} pagina="politica-cookies" version="cookies">
	<div slot="aside" class="eleccion">
		<h2 class="eleccion-titulo">{t.eleccionTitulo ?? cookies.configurar}</h2>
		{t.eleccionTexto && <p class="eleccion-texto">{t.eleccionTexto}</p>}
		<button type="button" class="btn btn-ghost" data-configurar-cookies>
			{cookies.configurar}
		</button>
	</div>
</PaginaLegal>

<style>
	.eleccion {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding-block-start: 1rem;
		border-block-start: 3px solid var(--color-text);
	}

	.eleccion-titulo {
		font-size: var(--fs-h3);
		font-weight: 700;
	}

	.eleccion-texto {
		color: var(--color-text-dim);
		margin-block-end: 0.5rem;
	}
</style>
