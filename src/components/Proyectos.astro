---
import { obtenerDescripciones } from '../lib/descripciones';
import { obtenerWebs } from '../lib/webs';
import { obtenerRepos } from '../lib/repos';
import type { Locale } from '../lib/i18n';
import { getDict } from '../lib/dictionary';
import imageOffIcon from 'lucide-static/icons/image-off.svg?raw';
import { getImage } from 'astro:assets';

interface Props {
	lang?: Locale;
	/** En la página de proyectos el h1 ya dice "Proyectos": el título de la sección queda solo para lectores de pantalla. */
	cabecera?: boolean;
}

const { lang = 'es', cabecera = true } = Astro.props;

const t = (getDict(lang, 'proyectos') as any).list;

// Las descripciones de los repos las genera Gemini a partir del README (ver src/lib/descripciones.js)
// y se cachean solo en es/en; traducirlas a los demás idiomas es un pipeline aparte que no toca
// esta tarea, así que para cualquier idioma que no sea español se reutiliza la versión en inglés.
const descLang = lang === 'es' ? 'es' : 'en';

const ESPECIALIZACIONES_MANUALES = ['R', 'SQL', 'Power BI'];

const repos = await obtenerRepos();

const languages = [...new Set([...repos.map((repo) => repo.language).filter(Boolean), ...ESPECIALIZACIONES_MANUALES])].sort() as string[];

let descripciones: Record<string, string> = {};
try {
	descripciones = await obtenerDescripciones(repos, descLang);
} catch (error) {
	console.error('Error al generar las descripciones con IA:', error);
}

let webs: Awaited<ReturnType<typeof obtenerWebs>> = [];
try {
	webs = await obtenerWebs();
} catch (error) {
	console.error('Error al obtener las webs de la organización de GitHub:', error);
}

// Las capturas se descargan al compilar y se sirven optimizadas desde esta web: así ninguna visita
// hace peticiones a GitHub (ni le envía su IP a un tercero) y cargan antes. Si una no existe, se
// muestra el marcador vacío.
const capturas = new Map<string, string | null>();
for (const web of webs) {
	try {
		const imagen = await getImage({ src: web.previewUrl, inferSize: true, width: 1280, format: 'webp' });
		capturas.set(web.name, imagen.src);
	} catch {
		capturas.set(web.name, null);
	}
}
---

<section id="proyectos" class="proyectos">
	<div class="container">
		{
			cabecera ? (
				<div class="section-header">
					<h2 class="titulo-seccion" data-entra>
						{t.title}
					</h2>
					<p class="lead" data-entra style="--i:1">
						{t.intro}
					</p>
				</div>
			) : (
				<h2 class="sr-only">{t.title}</h2>
			)
		}

		<div class="filtro" role="group" aria-label={t.filtroLabel}>
			<span class="filtro-indicador" aria-hidden="true"></span>
			<button type="button" class="filtro-btn is-active" data-filtro="todos" aria-pressed="true">
				{t.filtroTodos}
			</button>
			<button type="button" class="filtro-btn" data-filtro="webs" aria-pressed="false">
				{t.filtroWebs}
			</button>
			<button type="button" class="filtro-btn" data-filtro="datos" aria-pressed="false">
				{t.filtroDatos}
			</button>
		</div>

		<div class="panel" data-panel="webs">
			{
				webs.length > 0 ? (
					<div class="grid grid-webs">
						{webs.map((web, i) => (
							<article class="card card-web" data-tracking-proyecto={web.name} data-entra style={`--i:${i % 2}`}>
								<div class="card-preview" data-expandir>
									<div class="card-preview-capa" data-expandir-capa>
										<span class="preview-placeholder" set:html={imageOffIcon} />
										{capturas.get(web.name) && (
											<img src={capturas.get(web.name)} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
										)}
									</div>
									{web.enDesarrollo && <span class="badge-dev">{t.enDesarrollo}</span>}
								</div>
								<div class="card-body">
									<h3>{web.name}</h3>
									<p class="description">{web.description || t.fallbackDescripcionWeb}</p>
									{web.stack.length > 0 && <p class="card-stack">{web.stack.join(', ')}</p>}
									<div class="card-actions">
										{web.homepage && (
											<a class="button" href={web.homepage} target="_blank" rel="noopener noreferrer">
												{t.verWeb}
											</a>
										)}
										<a class="button button-secondary" href={web.htmlUrl} target="_blank" rel="noopener noreferrer">
											{t.verCodigo}
										</a>
									</div>
								</div>
							</article>
						))}
					</div>
				) : (
					<p class="empty text-dim">{t.vacioWebs}</p>
				)
			}
		</div>

		<div class="panel" data-panel="datos">
			{
				languages.length > 0 && (
					<div class="especializaciones">
						<h3>{t.especializaciones}</h3>
						<ul class="tags">
							{languages.map((especialidad) => (
								<li class="tag">{especialidad}</li>
							))}
						</ul>
					</div>
				)
			}

			{
				repos.length > 0 ? (
					<div class="grid grid-repos">
						{repos.map((repo, i) => (
							<article class="card" data-tracking-proyecto={repo.name} data-entra style={`--i:${i % 3}`}>
								<div class="card-header">
									<h3>{repo.name}</h3>
									{repo.language && <span class="language">{repo.language}</span>}
								</div>
								<p class="description">{descripciones[repo.name] || repo.description || t.fallbackDescripcion}</p>
								<a class="button" href={repo.html_url} target="_blank" rel="noopener noreferrer">
									{t.verEnGithub}
								</a>
							</article>
						))}
					</div>
				) : (
					<p class="empty text-dim">{t.vacio}</p>
				)
			}
		</div>
	</div>
</section>

<script>
	const seccion = document.querySelector('#proyectos');
	const botones = seccion?.querySelectorAll<HTMLButtonElement>('.filtro-btn');
	const paneles = seccion?.querySelectorAll<HTMLElement>('[data-panel]');

	const filtroEl = seccion?.querySelector<HTMLElement>('.filtro');

	// El indicador se desliza bajo el botón activo (solo transform y una anchura pequeña).
	const moverIndicador = (boton: HTMLElement) => {
		if (!filtroEl) return;
		const caja = filtroEl.getBoundingClientRect();
		const destino = boton.getBoundingClientRect();
		filtroEl.style.setProperty('--indicador-x', `${destino.left - caja.left}px`);
		filtroEl.style.setProperty('--indicador-w', `${destino.width}px`);
	};

	const activoInicial = seccion?.querySelector<HTMLElement>('.filtro-btn.is-active');
	if (activoInicial) {
		moverIndicador(activoInicial);
		requestAnimationFrame(() => filtroEl?.classList.add('is-listo'));
		window.addEventListener('resize', () => {
			const activo = seccion?.querySelector<HTMLElement>('.filtro-btn.is-active');
			if (activo) moverIndicador(activo);
		});
		// Las fuentes cambian el ancho de los botones al cargar: recolocar el indicador entonces.
		document.fonts?.ready.then(() => {
			const activo = seccion?.querySelector<HTMLElement>('.filtro-btn.is-active');
			if (activo) moverIndicador(activo);
		});
	}

	botones?.forEach((boton) => {
		boton.addEventListener('click', () => {
			const filtro = boton.dataset.filtro;
			moverIndicador(boton);

			botones.forEach((b) => {
				const activo = b === boton;
				b.classList.toggle('is-active', activo);
				b.setAttribute('aria-pressed', String(activo));
			});

			paneles?.forEach((panel) => {
				const visible = filtro === 'todos' || panel.dataset.panel === filtro;
				panel.hidden = !visible;
				if (visible) {
					// Lo que estaba oculto no llegó a "entrar": se muestra ya.
					panel.querySelectorAll('[data-entra]').forEach((el) => el.classList.add('is-in'));
					panel.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
				}
			});
		});
	});

	// Reordena las tarjetas de cada grid (Datos y Webs) según el tiempo de atención acumulado
	// que ya tenemos registrado en analítica. Si el endpoint falla, se deja el orden con el que
	// se generó la página (por fecha de actualización de cada repo) tal cual está.
	async function ordenarPorTiempo() {
		let tiempos;
		try {
			const response = await fetch('/api/proyectos/tiempos');
			if (!response.ok) return;
			tiempos = await response.json();
		} catch {
			return;
		}

		seccion?.querySelectorAll<HTMLElement>('[data-panel] .grid').forEach((grid) => {
			const tarjetas = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .card'));

			tarjetas.sort((a, b) => {
				const segundosA = tiempos[a.dataset.trackingProyecto ?? ''];
				const segundosB = tiempos[b.dataset.trackingProyecto ?? ''];
				const tieneA = typeof segundosA === 'number';
				const tieneB = typeof segundosB === 'number';

				if (tieneA && tieneB) return segundosB - segundosA;
				if (tieneA) return -1;
				if (tieneB) return 1;
				return 0; // ninguno tiene datos: se conserva el orden original (sort es estable)
			});

			tarjetas.forEach((tarjeta) => grid.appendChild(tarjeta));
		});
	}

	ordenarPorTiempo();
</script>

<style>
	.proyectos {
		padding-block-end: clamp(3.5rem, 7vw, 5rem);
	}

	.section-header {
		max-width: 60ch;
		margin-block-end: var(--space-block);
	}

	.section-header .lead {
		margin-block-start: 1.5rem;
	}

	/* Filtro: pestañas con una línea que se desliza a la opción activa */
	.filtro {
		position: relative;
		display: inline-flex;
		gap: 1.75rem;
		margin-block-end: clamp(2rem, 4vw, 3rem);
		border-block-end: 1px solid var(--color-border);
	}

	.filtro-indicador {
		position: absolute;
		inset-block-end: -1px;
		left: 0;
		block-size: 3px;
		inline-size: var(--indicador-w, 0);
		background: var(--color-accent);
		transform: translateX(var(--indicador-x, 0));
	}

	.filtro.is-listo .filtro-indicador {
		transition:
			transform 0.32s var(--ease-out),
			inline-size 0.32s var(--ease-out);
	}

	.filtro-btn {
		min-height: 48px;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--color-text-dim);
		background: transparent;
		border: none;
		padding: 0.4rem 0;
		cursor: pointer;
		transition: color var(--transition-fast);
	}

	.filtro-btn:hover,
	.filtro-btn.is-active {
		color: var(--color-text);
	}

	.filtro-btn:active {
		transform: scale(0.97);
	}

	.panel + .panel {
		margin-block-start: clamp(3.5rem, 7vw, 5.5rem);
	}

	.especializaciones {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.25rem;
		margin-block-end: 2rem;
	}

	.especializaciones h3 {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-text-dim);
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.2rem;
	}

	.tag {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
	}

	/* Repos como hoja de resultados: filas separadas por la línea de medición, sin cajas */
	.grid {
		display: grid;
		column-gap: var(--gutter);
	}

	.grid-repos {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
	}

	.grid-webs {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr));
		row-gap: clamp(2.5rem, 5vw, 3.5rem);
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.grid-repos .card {
		padding-block: 1.6rem 1.25rem;
		border-block-start: 1px solid var(--color-rule);
	}

	/* Al pasar por encima, la sprinter recorre la fila */
	.grid-repos .card::before {
		content: '';
		position: absolute;
		inset-block-start: -1px;
		inset-inline-start: 0;
		inline-size: 100%;
		block-size: 3px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: var(--origen-inline, left) center;
		transition: transform 0.45s var(--ease-out);
	}

	[dir='rtl'] .grid-repos .card::before {
		--origen-inline: right;
	}

	@media (hover: hover) and (pointer: fine) {
		.grid-repos .card:hover::before {
			transform: scaleX(1);
		}
	}

	.card-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-block-end: 0.7rem;
	}

	.card-header h3 {
		font-size: 1.45rem;
		font-weight: 700;
		word-break: break-word;
	}

	.language {
		flex-shrink: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-text-dim);
		white-space: nowrap;
	}

	.description {
		flex-grow: 1;
		font-size: 1rem;
		line-height: 1.6;
		margin: 0 0 1rem;
		max-width: 60ch;
	}

	.button {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-rule);
		text-underline-offset: 0.3em;
		transition: text-decoration-color var(--transition-fast);
	}

	@media (hover: hover) and (pointer: fine) {
		.button:hover {
			text-decoration-color: var(--color-accent);
		}
	}

	.button-secondary {
		color: var(--color-text-dim);
	}

	/* Webs: la captura manda */
	.card-preview {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: clip;
		background: var(--color-bg-elevated);
		border-radius: 4px;
		margin-block-end: 1.4rem;
	}

	.card-preview-capa {
		position: absolute;
		inset: 0;
		transform-origin: center;
	}

	.card-preview img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.9s var(--ease-expo);
	}

	@media (hover: hover) and (pointer: fine) {
		.card-web:hover .card-preview img {
			transform: scale(1.03);
		}
	}

	.preview-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-dim);
	}

	.preview-placeholder :global(svg) {
		width: 28px;
		height: 28px;
	}

	.badge-dev {
		position: absolute;
		inset-block-start: 0.85rem;
		inset-inline-start: 0.85rem;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		color: var(--pista-medicion);
		background: var(--pista-tarima);
		padding: 0.2rem 0.6rem;
		border-radius: 3px;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.card-body h3 {
		font-size: var(--fs-h3);
		font-weight: 700;
		word-break: break-word;
		margin-block-end: 0.6rem;
	}

	.card-stack {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
		color: var(--color-text-dim);
		margin-block-end: 0.75rem;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.6rem;
	}

	.empty {
		text-align: center;
	}
</style>
