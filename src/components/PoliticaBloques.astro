---
interface BloqueParrafo {
	tipo: 'parrafo';
	texto: string;
}
interface BloqueLista {
	tipo: 'lista';
	items: string[];
}
interface BloqueTabla {
	tipo: 'tabla';
	columnas: string[];
	filas: string[][];
}
type Bloque = BloqueParrafo | BloqueLista | BloqueTabla;

interface Props {
	bloques?: Bloque[];
}

const { bloques = [] } = Astro.props;

const URL_REGEX = /(https?:\/\/[^\s]+)/g;

function partirPorUrls(texto: string) {
	return texto.split(URL_REGEX).filter((parte) => parte !== '');
}

function esUrl(parte: string) {
	return /^https?:\/\//.test(parte);
}
---

{
	bloques.map((bloque) => {
		if (bloque.tipo === 'parrafo') {
			return (
				<p class="politica-parrafo">
					{partirPorUrls(bloque.texto).map((parte) =>
						esUrl(parte) ? (
							<a href={parte} target="_blank" rel="noopener noreferrer" class="politica-link">
								{parte}
							</a>
						) : (
							parte
						),
					)}
				</p>
			);
		}

		if (bloque.tipo === 'lista') {
			return (
				<ul class="politica-lista">
					{(bloque.items ?? []).map((item) => (
						<li>{item}</li>
					))}
				</ul>
			);
		}

		if (bloque.tipo === 'tabla') {
			const columnas = bloque.columnas ?? [];
			const filas = bloque.filas ?? [];
			return (
				<div class="politica-tabla-wrap">
					<table class="politica-tabla">
						<thead>
							<tr>
								{columnas.map((columna) => (
									<th>{columna}</th>
								))}
							</tr>
						</thead>
						<tbody>
							{filas.map((fila) => (
								<tr>
									{fila.map((celda, i) => (
										<td data-label={columnas[i] ?? ''}>{celda}</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			);
		}

		return null;
	})
}

<style>
	.politica-parrafo {
		font-size: 1.06rem;
		line-height: 1.7;
	}

	.politica-parrafo + .politica-parrafo,
	.politica-lista + .politica-parrafo,
	.politica-tabla-wrap + .politica-parrafo {
		margin-block-start: 1rem;
	}

	.politica-link {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 3px;
		overflow-wrap: anywhere;
	}

	.politica-lista {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-block: 1rem;
	}

	.politica-lista li {
		position: relative;
		padding-inline-start: 1.4rem;
		font-size: 1.04rem;
		line-height: 1.6;
	}

	/* Viñeta: un tramo corto de la línea sprinter */
	.politica-lista li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.72em;
		inline-size: 0.75rem;
		block-size: 3px;
		background: var(--color-accent);
	}

	.politica-tabla-wrap {
		overflow-x: auto;
		margin-block: 1.25rem;
		border-block-start: 3px solid var(--color-text);
	}

	.politica-tabla {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.98rem;
	}

	.politica-tabla th,
	.politica-tabla td {
		text-align: start;
		vertical-align: top;
		padding: 0.85rem 1rem 0.85rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.politica-tabla th {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--color-text);
		white-space: nowrap;
	}

	.politica-tabla td:first-child {
		font-family: var(--font-display);
		font-weight: 600;
		white-space: nowrap;
	}

	/* En el móvil cada fila de la tabla se lee como una ficha: etiqueta y valor, sin scroll lateral */
	@media (max-width: 600px) {
		.politica-tabla thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}

		.politica-tabla,
		.politica-tabla tbody,
		.politica-tabla tr,
		.politica-tabla td {
			display: block;
		}

		.politica-tabla tr {
			padding-block: 0.85rem;
			border-bottom: 1px solid var(--color-border);
		}

		.politica-tabla td {
			padding: 0.2rem 0;
			border: 0;
		}

		.politica-tabla td::before {
			content: attr(data-label);
			display: block;
			font-family: var(--font-display);
			font-weight: 600;
			font-size: 0.95rem;
			color: var(--color-text-dim);
		}

		.politica-tabla td:first-child {
			white-space: normal;
			font-size: 1.1rem;
		}

		.politica-tabla td:first-child::before {
			display: none;
		}
	}
</style>
