---
import { type Locale, localizedPath } from '../lib/i18n';
import { getDict } from '../lib/dictionary';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = (getDict(lang, 'common') as any).cookies;
const politicaHref = localizedPath('/politica-de-cookies', lang);
---

<div id="cookie-banner" class="cookie-banner" role="region" aria-label={t.ariaBanner} hidden>
	<div class="container cookie-banner-inner">
		<p class="cookie-banner-text">
			{t.texto} <a href={politicaHref} class="cookie-banner-link">{t.politica}</a>
		</p>
		<div class="cookie-banner-actions">
			<button type="button" id="cookie-btn-rechazar" class="cookie-btn">{t.rechazar}</button>
			<button type="button" id="cookie-btn-aceptar" class="cookie-btn">{t.aceptar}</button>
		</div>
	</div>
	<div id="cookie-banner-panel" class="container cookie-banner-panel" hidden>
		<button type="button" id="cookie-btn-borrar" class="cookie-panel-link">{t.borrarDatos}</button>
	</div>
</div>

<script>
	import { guardarDecision, hayQuePreguntar, leerConsentimiento, registrar } from '../scripts/consentimiento';

	const banner = document.getElementById('cookie-banner');
	const panel = document.getElementById('cookie-banner-panel');
	const btnAceptar = document.getElementById('cookie-btn-aceptar');
	const btnRechazar = document.getElementById('cookie-btn-rechazar');
	const btnBorrar = document.getElementById('cookie-btn-borrar');

	// "banner" la primera vez; "configuracion" cuando se abre desde el pie o desde la política de cookies
	let origenActual: 'banner' | 'configuracion' | 'politica_cookies' = 'banner';

	function mostrarBanner(conPanel: boolean) {
		banner?.removeAttribute('hidden');
		if (conPanel) panel?.removeAttribute('hidden');
		else panel?.setAttribute('hidden', '');
	}

	function ocultarBanner() {
		banner?.setAttribute('hidden', '');
		panel?.setAttribute('hidden', '');
	}

	// Se pregunta si no hay decisión o si la política de cookies ha cambiado desde la última
	if (hayQuePreguntar()) mostrarBanner(false);

	btnAceptar?.addEventListener('click', () => {
		guardarDecision('aceptado', origenActual);
		ocultarBanner();
	});

	btnRechazar?.addEventListener('click', () => {
		guardarDecision('rechazado', origenActual);
		ocultarBanner();
	});

	// Cualquier botón con data-configurar-cookies (el del pie, el de la política) abre la configuración
	document.querySelectorAll<HTMLElement>('#cookie-config-btn, [data-configurar-cookies]').forEach((boton) => {
		boton.addEventListener('click', () => {
			origenActual = boton.closest('main') ? 'politica_cookies' : 'configuracion';
			mostrarBanner(true);
		});
	});

	// Si la decisión cambia desde otro sitio (la casilla del formulario de contacto), el banner sobra
	window.addEventListener('consentimiento-cambiado', ocultarBanner);

	// Borrar mis datos = retirar el consentimiento (queda registrado) + borrar la analítica del servidor
	btnBorrar?.addEventListener('click', async () => {
		if (btnBorrar instanceof HTMLButtonElement) btnBorrar.disabled = true;
		const habiaAceptado = leerConsentimiento()?.decision === 'aceptado';
		registrar({ accion: habiaAceptado ? 'retirar' : 'rechazar', origen: origenActual === 'banner' ? 'configuracion' : origenActual, cookiesAnalitica: false });
		try {
			await fetch('/api/borrar-datos', { method: 'POST' });
		} finally {
			location.reload();
		}
	});
</script>

<style>
	/* Barra sólida, sin sombra ni desenfoque: separada del contenido solo por el filo superior */
	.cookie-banner {
		position: fixed;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 200;
		background: var(--color-bg-elevated);
		border-top: 1px solid var(--color-rule);
		padding-block-end: env(safe-area-inset-bottom);
		animation: banner-entrar 0.5s var(--ease-expo) 0.6s both;
	}

	@keyframes banner-entrar {
		from {
			transform: translateY(100%);
		}
	}

	.cookie-banner[hidden] {
		display: none;
	}

	.cookie-banner-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		padding-block: 1rem;
	}

	.cookie-banner-text {
		flex: 1 1 340px;
		font-size: var(--fs-small);
		line-height: 1.5;
		color: var(--color-text);
	}

	.cookie-banner-link {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-rule);
		text-underline-offset: 3px;
	}

	.cookie-banner-actions {
		display: flex;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	/* Mismo tamaño, mismo estilo base y mismo hover para "Aceptar" y "Rechazar":
	   ninguno de los dos debe parecer visualmente más prominente que el otro. */
	.cookie-btn {
		min-width: 120px;
		min-height: 44px;
		padding: 0.55rem 1.2rem;
		border-radius: 4px;
		border: 1px solid var(--color-rule);
		background: transparent;
		color: var(--color-text);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		cursor: pointer;
		transition:
			border-color var(--transition-fast),
			background-color var(--transition-fast),
			transform 0.12s var(--ease-out);
	}

	.cookie-btn:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.cookie-btn:hover {
			border-color: var(--color-text);
		}
	}

	.cookie-banner-panel {
		display: flex;
		justify-content: flex-end;
		padding-block-end: 1.25rem;
	}

	.cookie-banner-panel[hidden] {
		display: none;
	}

	.cookie-panel-link {
		background: none;
		border: none;
		padding: 0;
		font: inherit;
		font-size: var(--fs-small);
		color: var(--color-text-dim);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
		transition: color var(--transition-fast);
	}

	.cookie-panel-link:hover {
		color: var(--color-text);
	}

	.cookie-panel-link:disabled {
		opacity: 0.6;
		cursor: default;
	}

	@media (max-width: 560px) {
		.cookie-banner-actions {
			width: 100%;
		}

		.cookie-btn {
			flex: 1;
		}
	}
</style>
