---
import type { GetStaticPaths } from 'astro';
import PoliticaPrivacidadPage from '../../components/pages/PoliticaPrivacidadPage.astro';
import { NEW_LOCALES, type Locale } from '../../lib/i18n';

export const getStaticPaths = (() => NEW_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Locale };
---

<PoliticaPrivacidadPage lang={lang} />
