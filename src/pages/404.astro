---
import Layout from '../layouts/Layout.astro';
import LineasPista from '../components/LineasPista.astro';
import { localeFromPath, localizedPath } from '../lib/i18n';
import { getDict } from '../lib/dictionary';

const lang = localeFromPath(Astro.url.pathname);
const t = getDict(lang, '404') as any;
const common = getDict(lang, 'common') as any;
const home = localizedPath('/', lang);
const contacto = localizedPath('/contacto', lang);
---

<Layout title={t.title} description={t.description} lang={lang} noindex={true}>
	<section class="no-encontrada">
		<div class="container no-encontrada-inner">
			<p class="codigo" aria-hidden="true" data-carga>404</p>
			<div class="texto" data-carga style="--d:120ms">
				<h1 class="titulo">{t.heading}</h1>
				<p class="lead">{t.text}</p>
				<div class="acciones">
					<a href={home} class="btn btn-primary">{t.cta}</a>
					<a href={contacto} class="link-arrow">{common.nav.contacto}</a>
				</div>
			</div>
		</div>
		<LineasPista retraso={200} />
	</section>
</Layout>

<style>
	.no-encontrada {
		min-height: calc(100vh - var(--header-h));
		min-height: calc(100dvh - var(--header-h));
		display: grid;
		align-content: center;
		gap: clamp(3rem, 7vw, 5rem);
		padding-block: clamp(3rem, 8vw, 6rem);
	}

	.no-encontrada-inner {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
		gap: var(--gutter);
		align-items: end;
	}

	.codigo {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(7rem, 22vw, 17rem);
		line-height: 0.8;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.titulo {
		font-size: var(--fs-h2);
		font-weight: 800;
		line-height: 1;
		margin-block-end: 1.25rem;
	}

	.texto .lead {
		margin-block-end: 2rem;
		max-width: 36ch;
	}

	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.75rem;
	}

	@media (max-width: 760px) {
		.no-encontrada-inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
