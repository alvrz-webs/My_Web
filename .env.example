# Copia este fichero a .env (que está en .gitignore) y rellena los valores.
# Lo lee el proceso Node: astro dev / astro build y los scripts de scripts/.

# Google Gemini: descripciones de proyectos (build) y npm run translate
GEMINI_API_KEY=

# Opcional, solo lectura: sube el límite de la API de GitHub en el build de 60 a 5000/hora
GITHUB_API_TOKEN=

# Usuario del panel, para npm run panel:usuario (crear usuario o cambiar su contraseña).
# La contraseña NO va aquí: el script la pide por teclado y solo guarda su hash en D1.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_NOMBRE=
